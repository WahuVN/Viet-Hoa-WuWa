<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Presentation resources only. Merge into the existing app; preserve Commands and handlers. -->
  <SolidColorBrush x:Key="Wahu.Text" Color="#FAFAFF"/>
  <SolidColorBrush x:Key="Wahu.Muted" Color="#BFCAE6"/>
  <LinearGradientBrush x:Key="Wahu.Surface" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A21B2441" Offset="0"/><GradientStop Color="#9B202C4C" Offset="0.58"/><GradientStop Color="#A017223F" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="Wahu.InputBrush" Color="#DF151E37"/>
  <SolidColorBrush x:Key="Wahu.Border" Color="#8E8B9CCA"/>
  <SolidColorBrush x:Key="Wahu.Accent" Color="#BCAEFF"/>
  <SolidColorBrush x:Key="Wahu.Success" Color="#8BD9BF"/>
  <SolidColorBrush x:Key="Wahu.Warning" Color="#E6C486"/>
  <SolidColorBrush x:Key="Wahu.Error" Color="#EAA2AF"/>
  <LinearGradientBrush x:Key="Wahu.Primary" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DBC5FF" Offset="0"/><GradientStop Color="#83DCE8" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="Wahu.Purple" Color="#AC9CFA"/>
  <SolidColorBrush x:Key="Wahu.TitleBarBackground" Color="#0C1023"/>
  <LinearGradientBrush x:Key="Wahu.HeaderAccent" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#788C93F1" Offset="0"/><GradientStop Color="#508DD8EE" Offset="0.53"/><GradientStop Color="#007B8CCF" Offset="1"/></LinearGradientBrush>
  <Style x:Key="Wahu.TextBlock" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Wahu.Text}"/><Setter Property="FontFamily" Value="{DynamicResource WahuAppFontFamily}"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <!-- Soft violet-to-slate edge adds definition without expensive blur effects. -->
  <!-- Shared violet-to-cyan edge reflection on every card. -->
  <LinearGradientBrush x:Key="Wahu.CardStroke" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B8ADA7EF" Offset="0"/><GradientStop Color="#829D9BCA" Offset="0.57"/><GradientStop Color="#6888CDE4" Offset="1"/></LinearGradientBrush>
  <Style x:Key="Wahu.GlassCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Wahu.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Wahu.CardStroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="15"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
  <Style x:Key="Wahu.SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Wahu.ButtonSecondary}"/><Setter Property="Foreground" Value="{DynamicResource Wahu.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Wahu.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="16,9"/><Setter Property="FontFamily" Value="{DynamicResource WahuAppFontFamily}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Wahu.TableHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Wahu.TableSurface}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wahu.Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Wahu.DisabledSurface}"/><Setter Property="Foreground" Value="#73849F"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Wahu.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Wahu.SecondaryButton}">
    <Setter Property="Background" Value="{DynamicResource Wahu.Primary}"/><Setter Property="Foreground" Value="#102338"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="#80AADAE4" BorderThickness="1" CornerRadius="9"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#B6F5ED"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#56B8D4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Wahu.DisabledSurface}"/><Setter Property="Foreground" Value="#73849F"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Wahu.Input" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Wahu.InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource Wahu.Text}"/><Setter Property="CaretBrush" Value="{DynamicResource Wahu.Accent}"/><Setter Property="SelectionBrush" Value="#5265D6DF"/><Setter Property="BorderBrush" Value="{DynamicResource Wahu.Border}"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wahu.Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wahu.Error}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Wahu.DropdownItem" TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Wahu.Text}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2B3157"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Wahu.TableHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Wahu.Dropdown" TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{DynamicResource Wahu.Text}" />
    <Setter Property="Background" Value="{DynamicResource Wahu.InputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Wahu.Border}" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Wahu.DropdownItem}" />
    <Setter Property="MaxDropDownHeight" Value="300" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
            <Border x:Name="Chrome" CornerRadius="7"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              Margin="12,0,34,0" HorizontalAlignment="Left"
                              VerticalAlignment="Center" IsHitTestVisible="False" />
            <Path Data="M0,0 L5,5 L10,0" Stroke="#B8ACF8" StrokeThickness="1.7"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                  IsHitTestVisible="False" />
            <ToggleButton x:Name="Toggle" BorderThickness="0" Background="Transparent"
                          Opacity="0" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                   PopupAnimation="Fade">
              <Border Background="{DynamicResource Wahu.InputBrush}"
                      BorderBrush="{DynamicResource Wahu.Border}"
                      BorderThickness="1" CornerRadius="7"
                      Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer CanContentScroll="True"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wahu.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wahu.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Wahu.Checkbox" TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Wahu.Text}"/><Setter Property="MinHeight" Value="32"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Wahu.Border}" Background="{DynamicResource Wahu.InputBrush}"><Path x:Name="Tick" Visibility="Collapsed" Data="M3,8 L7,12 L14,5" Stroke="#102338" StrokeThickness="2"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Wahu.Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Wahu.Radio" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Wahu.Text}"/><Setter Property="MinHeight" Value="32"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><StackPanel Orientation="Horizontal"><Grid Width="18" Height="18"><Ellipse x:Name="Ring" Stroke="{DynamicResource Wahu.Border}" Fill="{DynamicResource Wahu.InputBrush}"/><Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Wahu.Accent}" Visibility="Collapsed"/></Grid><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Wahu.Toggle" TargetType="CheckBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#28394F"><Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#BAC8DC" HorizontalAlignment="Left" Margin="4,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Wahu.Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="#102338"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Wahu.Slider" TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource Wahu.Accent}"/><Setter Property="MinHeight" Value="32"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="4" Background="#35455D" CornerRadius="2" VerticalAlignment="Center"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource Wahu.Accent}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#D7F7F9" Stroke="{DynamicResource Wahu.Accent}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Wahu.Progress" TargetType="ProgressBar"><Setter Property="Height" Value="6"/><Setter Property="Foreground" Value="{DynamicResource Wahu.Accent}"/><Setter Property="Background" Value="#30415C"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/></Grid><ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Trigger.EnterActions><BeginStoryboard x:Name="Pulse"><Storyboard><DoubleAnimation Storyboard.TargetName="PART_Track" Storyboard.TargetProperty="Opacity" From=".45" To="1" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse"/></Trigger.ExitActions></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Wahu.SidebarItem" TargetType="RadioButton"><Setter Property="Foreground" Value="#B6C5DC"/><Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="14,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chrome" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#203149"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2B3157"/><Setter Property="Foreground" Value="{DynamicResource Wahu.Text}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wahu.Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <!-- Unified navy/lavender palette used by every editor page. The original illustration
       remains visible only on Home; editing tabs use an inexpensive static backdrop. -->
  <!-- Shared lavender/cyan edge lighting: static double-stroke curves, not blur animations. -->
  <DrawingBrush x:Key="Wahu.PageBackground" Stretch="Fill">
    <DrawingBrush.Drawing><DrawingGroup>
      <GeometryDrawing Geometry="M0,0 L1200,0 1200,820 0,820 Z">
        <GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#12192F" Offset="0"/><GradientStop Color="#242D4D" Offset="0.58"/><GradientStop Color="#171F39" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush>
      </GeometryDrawing>
        <GeometryDrawing Geometry="M695,78 C844,131 1002,93 1197,61"><GeometryDrawing.Pen><Pen Thickness="7"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#007B8DEA" Offset="0"/><GradientStop Color="#269D8BF2" Offset="0.5"/><GradientStop Color="#1682D5EF" Offset="1"/></LinearGradientBrush></Pen.Brush></Pen></GeometryDrawing.Pen></GeometryDrawing>
        <GeometryDrawing Geometry="M695,78 C844,131 1002,93 1197,61"><GeometryDrawing.Pen><Pen Thickness="1.65"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#367D8CE1" Offset="0"/><GradientStop Color="#B1B7A8FF" Offset="0.5"/><GradientStop Color="#8E8ADCEA" Offset="1"/></LinearGradientBrush></Pen.Brush></Pen></GeometryDrawing.Pen></GeometryDrawing>
        <GeometryDrawing Geometry="M750,100 C949,143 1098,103 1200,90"><GeometryDrawing.Pen><Pen Thickness="1"><Pen.Brush><SolidColorBrush Color="#468CCFE9"/></Pen.Brush></Pen></GeometryDrawing.Pen></GeometryDrawing>
        <GeometryDrawing Geometry="M4,811 C285,708 656,803 912,706 C1051,654 1149,672 1200,646"><GeometryDrawing.Pen><Pen Thickness="7"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#169C8BEF" Offset="0"/><GradientStop Color="#20A8A2FF" Offset="0.5"/><GradientStop Color="#1670BFEE" Offset="1"/></LinearGradientBrush></Pen.Brush></Pen></GeometryDrawing.Pen></GeometryDrawing>
        <GeometryDrawing Geometry="M4,811 C285,708 656,803 912,706 C1051,654 1149,672 1200,646"><GeometryDrawing.Pen><Pen Thickness="1.6"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#5C918CE8" Offset="0"/><GradientStop Color="#A2B8AEFA" Offset="0.5"/><GradientStop Color="#7D80D2E9" Offset="1"/></LinearGradientBrush></Pen.Brush></Pen></GeometryDrawing.Pen></GeometryDrawing>
        <GeometryDrawing Geometry="M45,815 C360,750 642,831 933,744 C1035,712 1130,727 1200,708"><GeometryDrawing.Pen><Pen Thickness="1"><Pen.Brush><SolidColorBrush Color="#4187C4EC"/></Pen.Brush></Pen></GeometryDrawing.Pen></GeometryDrawing>
    </DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
  <SolidColorBrush x:Key="Wahu.TableSurface" Color="#1C2440" />
  <SolidColorBrush x:Key="Wahu.TableAlternate" Color="#222C4C" />
  <SolidColorBrush x:Key="Wahu.TableHeader" Color="#303A59" />
  <SolidColorBrush x:Key="Wahu.TableLine" Color="#30405F" />
  <SolidColorBrush x:Key="Wahu.TableHover" Color="#34416B" />
  <SolidColorBrush x:Key="Wahu.TableSelected" Color="#414973" />
  <SolidColorBrush x:Key="Wahu.ButtonSecondary" Color="#293350" />
  <SolidColorBrush x:Key="Wahu.DisabledSurface" Color="#25304A" />
  <Style x:Key="Wahu.EditorInput" TargetType="TextBox" BasedOn="{StaticResource Wahu.Input}">
    <Setter Property="Background" Value="{DynamicResource Wahu.InputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Wahu.TableLine}" />
    <Setter Property="Foreground" Value="{DynamicResource Wahu.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource WahuAppFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="33" />
    <Setter Property="Padding" Value="9,5" />
  </Style>
  <!-- Preserve ComboBox DisplayMemberPath/SelectedItem with native WPF template. -->
  <Style x:Key="Wahu.SimpleDropdown" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Wahu.InputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Wahu.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Wahu.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource WahuAppFontFamily}" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="9,5" />
  </Style>

  <!-- Paired theme-aware launcher video/card colors. -->
  <SolidColorBrush x:Key="Wahu.HomeText" Color="#F6F8FF"/>
  <SolidColorBrush x:Key="Wahu.HomeMuted" Color="#CAD6EA"/>
  <SolidColorBrush x:Key="Wahu.HomeAccentText" Color="#C8BAFF"/>
  <LinearGradientBrush x:Key="Wahu.HomeCard" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DA182440" Offset="0"/><GradientStop Color="#CD1B2948" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="Wahu.HomeBorder" Color="#9E8D9FCC"/>
  <SolidColorBrush x:Key="Wahu.HomeInput" Color="#ED15213B"/>
  <SolidColorBrush x:Key="Wahu.HomeButton" Color="#DE202D4A"/>
  <LinearGradientBrush x:Key="Wahu.HomeHeroHorizontalShade" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#3809111E" Offset="0"/><GradientStop Color="#18161A39" Offset="0.37"/><GradientStop Color="#05181D4D" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Wahu.HomeHeroVerticalShade" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#10101626" Offset="0"/><GradientStop Color="#00101626" Offset="0.42"/><GradientStop Color="#3D08111E" Offset="1"/></LinearGradientBrush>
  <!-- Sidebar follows Light/Dark as well, including nav text and focus. -->
  <SolidColorBrush x:Key="Wahu.WindowBackground" Color="#0B1124"/>
  <DrawingBrush x:Key="Wahu.SideBackground" Stretch="Fill"><DrawingBrush.Drawing><DrawingGroup>
    <GeometryDrawing Geometry="M0,0 L211,0 211,820 0,820 Z" Brush="#0E1429"/>
    <GeometryDrawing Geometry="M0,805 C73,760 150,723 211,669"><GeometryDrawing.Pen><Pen Brush="#258F8CE9" Thickness="7"/></GeometryDrawing.Pen></GeometryDrawing>
    <GeometryDrawing Geometry="M0,805 C73,760 150,723 211,669"><GeometryDrawing.Pen><Pen Thickness="1.5"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#A0B4A8FA" Offset="0"/><GradientStop Color="#748BDDF3" Offset="1"/></LinearGradientBrush></Pen.Brush></Pen></GeometryDrawing.Pen></GeometryDrawing>
    <GeometryDrawing Geometry="M18,818 C96,773 169,743 211,702"><GeometryDrawing.Pen><Pen Brush="#4982C7EE" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing>
  </DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
  <SolidColorBrush x:Key="Wahu.SideHover" Color="#202943"/>
  <SolidColorBrush x:Key="Wahu.SideSelected" Color="#303457"/>
  <SolidColorBrush x:Key="Wahu.SideBorder" Color="#44506C"/>
  <SolidColorBrush x:Key="Wahu.SideFocus" Color="#A99CF4"/>
  <LinearGradientBrush x:Key="Wahu.SideRail" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DAC4FF" Offset="0"/><GradientStop Color="#83D8EC" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="Wahu.SidePrimary" Color="#F4F3FF"/>
  <SolidColorBrush x:Key="Wahu.SideSecondary" Color="#B4BEDB"/>
  <SolidColorBrush x:Key="Wahu.SideMuted" Color="#A3AFD0"/>
</ResourceDictionary>
