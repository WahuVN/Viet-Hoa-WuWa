<ui:FluentWindow x:Class="VHWuWa.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="WuWa Việt Hóa · Wuthering Waves"
                  Icon="/Assets/app-logo-transparent.ico"
                  Width="1180" Height="740" MinWidth="980" MinHeight="620"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  Background="#0D0F12"
                  FontFamily="{StaticResource WahuAppFontFamily}" FontSize="14"
                  UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
        <!-- Sidebar semantic palette. Reuse neutral surfaces from the content pages. -->
        <SolidColorBrush x:Key="WahuSideBackground" Color="#171A1F" />
        <SolidColorBrush x:Key="WahuSideHover" Color="#24272C" />
        <SolidColorBrush x:Key="WahuSideSelected" Color="#2D3036" />
        <SolidColorBrush x:Key="WahuSideBorder" Color="#373B42" />
        <SolidColorBrush x:Key="WahuSideFocus" Color="#737A84" />
        <SolidColorBrush x:Key="WahuSideRail" Color="#C8CDD3" />
        <SolidColorBrush x:Key="WahuSidePrimary" Color="#F1F3F5" />
        <SolidColorBrush x:Key="WahuSideSecondary" Color="#C3C7CD" />
        <SolidColorBrush x:Key="WahuSideMuted" Color="#969DA6" />
        <!-- Compact, accessible desktop navigation: restrained slate palette, vector icons,
             clear grouping, hover/focus feedback and a persistent selection rail. -->
        <Style x:Key="WahuNavGlyphStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Margin" Value="0,0,13,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="StrokeThickness" Value="1.65" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
        </Style>
        <Style x:Key="WahuNavLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource WahuAppFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
        </Style>
        <Style x:Key="WahuNavGroupStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="23" />
            <Setter Property="Margin" Value="6,9,6,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <TextBlock Text="{TemplateBinding Content}" Margin="12,2,0,0"
                                   Foreground="{StaticResource WahuSideMuted}" FontFamily="{StaticResource WahuAppFontFamily}"
                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WahuNavItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FontFamily" Value="{StaticResource WahuAppFontFamily}" />
            <Setter Property="MinHeight" Value="43" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Foreground" Value="{StaticResource WahuSideSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid>
                            <Border x:Name="NavSurface" CornerRadius="9"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <Border x:Name="ActiveRail" Width="3" CornerRadius="2"
                                    Margin="0,10,0,10" HorizontalAlignment="Left"
                                    Background="{StaticResource WahuSideRail}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource WahuSideHover}" />
                                <Setter Property="Foreground" Value="{StaticResource WahuSidePrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource WahuSideSelected}" />
                                <Setter TargetName="ActiveRail" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource WahuSidePrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource WahuSideFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Footer actions share the navigation surface instead of separate blue-gray buttons. -->
        <Style x:Key="WahuSideFooterButton" TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="{StaticResource WahuAppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource WahuSideSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="FooterSurface" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterSurface" Property="Background"
                                        Value="{StaticResource WahuSideHover}" />
                                <Setter Property="Foreground" Value="{StaticResource WahuSidePrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterSurface" Property="Background"
                                        Value="{StaticResource WahuSideSelected}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FooterSurface" Property="BorderBrush"
                                        Value="{StaticResource WahuSideFocus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WuWa Việt Hóa" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    Background="{StaticResource WahuSideBackground}" BorderBrush="{StaticResource WahuSideBorder}">
                <DockPanel Margin="6,0,6,6">
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,6,4,4">
                        <Border Height="1" Background="{StaticResource WahuSideBorder}" Margin="2,3,2,5" />

                        <!-- Banner thông báo khi có bản mới ở sidebar -->
                        <Border Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource WahuSideHover}" BorderBrush="{StaticResource WahuSideBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="11,9" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock Text="{Binding LatestVersion, StringFormat='Có bản mới v{0}'}"
                                           FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource WahuSidePrimary}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Content="Bản dịch" Appearance="Secondary"
                                               ToolTip="Chỉ tải bản dịch mới, không thay đổi phiên bản ứng dụng"
                                               Command="{Binding ApplyDeltaPakUpdateCommand}"
                                               IsEnabled="{Binding HasDeltaPak}"
                                               HorizontalAlignment="Stretch" Padding="2,3" FontSize="10" />
                                    <ui:Button Grid.Column="2" Content="Ứng dụng" Appearance="Secondary"
                                               ToolTip="Cập nhật ứng dụng và bản dịch, giữ nguyên cấu hình"
                                               Command="{Binding ApplyUpdateCommand}"
                                               HorizontalAlignment="Stretch" Padding="2,3" FontSize="10" />
                                </Grid>
                                <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="3" Margin="0,4,0,0"
                                             Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Version and state: informational text, not another decorated card. -->
                        <StackPanel Margin="9,5,9,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="5" Height="5" Fill="{StaticResource WahuSideSecondary}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding AppVersion}"
                                           Foreground="{StaticResource WahuSideSecondary}"
                                           FontSize="11" FontWeight="Medium" />
                            </Grid>
                            <TextBlock Text="{Binding GameStatus}" Foreground="{StaticResource WahuSideMuted}"
                                       FontSize="10.5" Margin="14,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding OpenDiscordCommand}" ToolTip="Discord"
                                    Style="{StaticResource WahuSideFooterButton}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="15" Height="15" Margin="0,0,5,0">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M19.5,5.34 A16.3,16.3 0 0 0 15.44,4 L14.94,5.02 A15.4,15.4 0 0 0 9.06,5.02 L8.55,4 A16.3,16.3 0 0 0 4.5,5.34 C1.94,9.14 1.25,12.85 1.6,16.5 A16.6,16.6 0 0 0 6.55,19 L7.75,17.35 C7.09,17.12 6.47,16.82 5.9,16.45 C9.65,19.22 14.35,19.22 18.16,16.45 C17.57,16.83 16.94,17.13 16.28,17.36 L17.48,19 A16.6,16.6 0 0 0 22.42,16.51 C22.84,12.28 21.7,8.6 19.5,5.34 Z M8.6,14.25 C7.52,14.25 6.64,13.26 6.64,12.04 C6.64,10.82 7.5,9.83 8.6,9.83 C9.7,9.83 10.58,10.82 10.56,12.04 C10.56,13.26 9.7,14.25 8.6,14.25 Z M15.4,14.25 C14.32,14.25 13.44,13.26 13.44,12.04 C13.44,10.82 14.3,9.83 15.4,9.83 C16.5,9.83 17.38,10.82 17.36,12.04 C17.36,13.26 16.5,14.25 15.4,14.25 Z" />
                                    </Viewbox>
                                    <TextBlock Text="Discord" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding OpenGitHubCommand}" ToolTip="GitHub"
                                    Style="{StaticResource WahuSideFooterButton}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="15" Height="15" Margin="0,0,5,0">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12,1 C5.923,1 1,5.923 1,12 C1,16.867 4.149,20.979 8.521,22.436 C9.071,22.532 9.277,22.203 9.277,21.914 C9.277,21.652 9.264,20.786 9.264,19.865 C6.5,20.374 5.785,19.191 5.565,18.573 C5.441,18.256 4.905,17.28 4.438,17.019 C4.053,16.812 3.502,16.304 4.424,16.29 C5.29,16.276 5.909,17.087 6.115,17.418 C7.105,19.081 8.686,18.614 9.319,18.325 C9.415,17.61 9.704,17.129 10.02,16.854 C7.613,16.579 5.097,15.658 5.097,11.491 C5.097,10.308 5.509,9.332 6.183,8.576 C6.073,8.301 5.702,7.188 6.286,5.689 C6.286,5.689 7.18,5.401 9.311,6.803 A10.2,10.2 0 0 1 12.061,6.432 C12.996,6.432 13.931,6.555 14.811,6.803 C16.943,5.387 17.836,5.689 17.836,5.689 C18.42,7.188 18.049,8.301 17.939,8.576 C18.613,9.332 19.025,10.295 19.025,11.491 C19.025,15.672 16.495,16.579 14.088,16.854 C14.473,17.184 14.817,17.83 14.817,18.834 C14.817,20.264 14.803,21.419 14.803,21.79 C14.803,22.079 15.009,22.422 15.559,22.312 A11.02,11.02 0 0 0 23,12 C23,5.923 18.078,1 12,1 Z" />
                                    </Viewbox>
                                    <TextBlock Text="GitHub" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </Grid>


                    </StackPanel>
                    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource WahuSideBorder}" Margin="12,9,12,10" Padding="0,9,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Use the original high-resolution PNG instead of a 28px ICO thumbnail. -->
                            <Image Source="/Assets/logo-app-transparent.png" Width="48" Height="48"
                                   Stretch="Uniform" SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="Biểu trưng WuWa Việt Hóa"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="WuWa Việt Hóa" Foreground="{StaticResource WahuSidePrimary}"
                                           FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Text="Wuthering Waves · PC"
                                           Foreground="{StaticResource WahuSideMuted}"
                                           FontSize="10.5" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource WahuNavItemStyle}">
                        <ListBoxItem Style="{StaticResource WahuNavGroupStyle}" Content="TỔNG QUAN" />
                        <ListBoxItem Tag="home" AutomationProperties.Name="Trang chủ">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource WahuNavGlyphStyle}"
                                      Data="M3,10.5 L12,3 L21,10.5 M5.5,9 V20 H10 V14 H14 V20 H18.5 V9" />
                                <TextBlock Style="{StaticResource WahuNavLabelStyle}" Text="Trang chủ" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource WahuNavGroupStyle}" Content="CÁ NHÂN HÓA" />
                        <ListBoxItem Tag="characters" AutomationProperties.Name="Tên nhân vật">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource WahuNavGlyphStyle}"
                                      Data="M16,8 A4,4 0 1 1 8,8 A4,4 0 1 1 16,8 M4,21 C4,16 8,14 12,14 C16,14 20,16 20,21" />
                                <TextBlock Style="{StaticResource WahuNavLabelStyle}" Text="Tên nhân vật" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="terms" AutomationProperties.Name="Thuật ngữ">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource WahuNavGlyphStyle}"
                                      Data="M5,4 H19 V20 H5 Z M8,8 H16 M8,12 H16 M8,16 H13" />
                                <TextBlock Style="{StaticResource WahuNavLabelStyle}" Text="Thuật ngữ" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="uid" AutomationProperties.Name="UID">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource WahuNavGlyphStyle}"
                                      Data="M4,8 V5 H8 M16,5 H20 V8 M20,16 V20 H16 M8,20 H4 V16 M9,10 H15 V14 H9 Z" />
                                <TextBlock Style="{StaticResource WahuNavLabelStyle}" Text="UID" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="font" AutomationProperties.Name="Font game">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource WahuNavGlyphStyle}"
                                      Data="M5,19 L11,5 H13 L19,19 M7.5,14 H16.5" />
                                <TextBlock Style="{StaticResource WahuNavLabelStyle}" Text="Font game" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="graphics" AutomationProperties.Name="Đồ họa">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource WahuNavGlyphStyle}"
                                      Data="M3,5 H21 V18 H3 Z M9,22 H15 M12,18 V22 M6,14 L10,10 L13,13 L17,8" />
                                <TextBlock Style="{StaticResource WahuNavLabelStyle}" Text="Đồ họa" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource WahuNavGroupStyle}" Content="HỆ THỐNG" />
                        <ListBoxItem Tag="guide" AutomationProperties.Name="Trợ giúp">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource WahuNavGlyphStyle}"
                                      Data="M4,5 C8,3 10,5 12,6 C14,5 17,3 20,5 V19 C17,17 14,18 12,20 C10,18 7,17 4,19 Z M12,6 V20" />
                                <TextBlock Style="{StaticResource WahuNavLabelStyle}" Text="Trợ giúp" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings" AutomationProperties.Name="Cài đặt">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource WahuNavGlyphStyle}"
                                      Data="M12,3 L13.5,5.1 L16,5.8 L18.2,4.8 L19.2,5.8 L18.2,8 L18.9,10.5 L21,12 L18.9,13.5 L18.2,16 L19.2,18.2 L18.2,19.2 L16,18.2 L13.5,18.9 L12,21 L10.5,18.9 L8,18.2 L5.8,19.2 L4.8,18.2 L5.8,16 L5.1,13.5 L3,12 L5.1,10.5 L5.8,8 L4.8,5.8 L5.8,4.8 L8,5.8 L10.5,5.1 Z M15.2,12 A3.2,3.2 0 1 1 8.8,12 A3.2,3.2 0 1 1 15.2,12" />
                                <TextBlock Style="{StaticResource WahuNavLabelStyle}" Text="Cài đặt" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="0" />
        </Grid>
    </Grid>
</ui:FluentWindow>
