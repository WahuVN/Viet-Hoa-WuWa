<UserControl x:Class="VHWuWa.App.Views.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource Wahu.PageBackground}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Việt hóa" FontFamily="{StaticResource WahuHeadingFontFamily}" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="{Binding GamePathText}" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
            <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Wahu.Muted}" />
            <TextBlock Text="{Binding ContentText}" Margin="0,7,0,0" TextWrapping="Wrap"
                       FontSize="13" Foreground="{DynamicResource Wahu.Text}" />
        </StackPanel>

        <ui:Card Background="{DynamicResource Wahu.Surface}" BorderBrush="{DynamicResource Wahu.Border}" BorderThickness="1" Grid.Row="1" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Tên nhân vật" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <RadioButton GroupName="install-name-variant" IsChecked="{Binding VariantEnglish, Mode=TwoWay}"
                             Content="Tên tiếng Anh" Margin="0,4" FontSize="13" />
                <RadioButton GroupName="install-name-variant" IsChecked="{Binding VariantHanViet, Mode=TwoWay}" IsEnabled="{Binding IsHanVietAvailable}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding OptionHelpText}"
                             Content="Tên Hán Việt" Margin="0,4" FontSize="13" />
                <Button Style="{StaticResource WahuStandardButtonStyle}" Content="{Binding HanVietDownloadBtnText}" Command="{Binding DownloadHanVietCommand}"
                        Visibility="{Binding ShowHanVietDownload, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left" Margin="28,4,0,2" Padding="10,5" FontSize="12.5" />
                <TextBlock Margin="28,4,0,2" FontSize="12.5" Opacity="0.78" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="Tên được đổi: " />
                    <Run Text="Jinhsi → Kim Tịch, Changli → Trường Ly, Yangyang → Ương Ương, Jiyan → Kỵ Viêm, Sanhua → Tán Hoa, Taoqi → Đào Kỳ…" />
                    <LineBreak />
                    <Run FontWeight="SemiBold" Text="Tên giữ nguyên: " />
                    <Run Text="Aemeath, Shorekeeper, Aalto, Encore, Ciaccona, Mornye và các tên chưa có quy ước Hán Việt." />
                </TextBlock>
                <CheckBox IsChecked="{Binding ApplyFont, Mode=TwoWay}" IsEnabled="{Binding FontAvailable}"
                          Content="Cài kèm font chữ tiếng Việt" Margin="0,10,0,0" FontSize="12" />
                <TextBlock Text="{Binding OptionHelpText}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Foreground="{DynamicResource Wahu.Muted}" FontSize="12" />
            </StackPanel>
        </ui:Card>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ui:Card Background="{DynamicResource Wahu.Surface}" BorderBrush="{DynamicResource Wahu.Border}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cài Việt hóa" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <WrapPanel>
                            <ui:Button Content="Cài Việt hóa" Appearance="Primary"
                                       Command="{Binding InstallCommand}" Margin="0,0,8,8"
                                       MinWidth="180" Padding="16,9" FontSize="14" FontWeight="SemiBold" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Hủy" Command="{Binding CancelCommand}"
                                    Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,8,8" Padding="12,8" FontSize="12" />
                        </WrapPanel>
                        <TextBlock Text="Hãy đóng game trước khi cài/gỡ R29. Mount không xác minh được sẽ bị chặn, không xóa."
                                   TextWrapping="Wrap" Opacity="0.65" Margin="0,4,0,0" FontSize="12" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                   FontWeight="SemiBold" Margin="0,10,0,0" FontSize="12" />
                    </StackPanel>
                </ui:Card>

                <Expander Header="Tùy chọn khác" IsExpanded="False" Margin="0,0,0,12" Padding="8,4">
                    <StackPanel Margin="8,8,8,4">
                        <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Gỡ Việt hóa" Command="{Binding UninstallCommand}"
                                HorizontalAlignment="Left" Padding="12,8" FontSize="12" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3">
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" />
            <TextBlock Text="{Binding ProgressText}" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
    </Grid>
</UserControl>
