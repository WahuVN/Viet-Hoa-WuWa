<UserControl x:Class="VHWuWa.App.Views.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Cài đặt Việt hóa" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding GamePathText}" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
            <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Foreground="#4ade80" />
        </StackPanel>

        <ui:Card Grid.Row="1" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="1 · Chọn kiểu tên nhân vật trong game" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <RadioButton GroupName="variant" IsChecked="{Binding VariantEnglish, Mode=TwoWay}"
                             Content="🔤  Tên tiếng Anh chuẩn  (Jinhsi, Changli, Yinlin, Shorekeeper, Xiangli Yao…)" Margin="0,4" FontSize="13" />
                <RadioButton GroupName="variant" IsChecked="{Binding VariantHanViet, Mode=TwoWay}"
                             Content="🇻🇳  Tên Hán Việt chuẩn  (Kim Tịch, Trường Ly, Ngâm Lâm, Thủ Ngạn Nhân, Tương Lý Yếu…)" Margin="0,4" FontSize="13" />
                <CheckBox IsChecked="{Binding ApplyFont, Mode=TwoWay}" IsEnabled="{Binding FontAvailable}"
                          Content="Cài kèm Font chữ tiếng Việt sắc nét (Khuyến nghị)" Margin="0,10,0,0" FontSize="12" />
            </StackPanel>
        </ui:Card>

        <StackPanel Grid.Row="2">
            <ui:InfoBar IsOpen="True" Severity="Warning" Margin="0,0,0,10"
                        Title="Kiểm tra xung đột mod" Message="{Binding ConflictText}" />
            <ui:Card Padding="16" Margin="0,0,0,12" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="2 · Cài đặt hoặc Gỡ bỏ" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                    <WrapPanel>
                        <ui:Button Content="⬇ Cài Việt hóa ngay" Appearance="Primary"
                                   Command="{Binding InstallCommand}" Margin="0,0,8,8" MinWidth="160" Padding="14,8" FontSize="13" FontWeight="SemiBold" />
                        <Button Content="🗑 Gỡ Việt hóa" Command="{Binding UninstallCommand}" Margin="0,0,8,8" Padding="12,8" FontSize="12" />
                        <Button Content="🔎 Quét lại mod" Command="{Binding CheckConflictsCommand}" Margin="0,0,8,8" Padding="12,8" FontSize="12" />
                        <Button Content="✖ Hủy" Command="{Binding CancelCommand}"
                                Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,0,8,8" Padding="12,8" FontSize="12" />
                    </WrapPanel>
                    <TextBlock Text="⚠ Lưu ý: Hãy TẮT GAME hoàn toàn trước khi cài. Sau khi cài xong, vào Cài đặt game → Ngôn ngữ → Text = English."
                               TextWrapping="Wrap" Opacity="0.65" Margin="0,6,0,0" FontSize="12" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0" FontSize="12" />
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" />
            <TextBlock Text="{Binding ProgressText}" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
    </Grid>
</UserControl>
