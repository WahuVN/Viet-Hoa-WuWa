<UserControl x:Class="VHWuWa.App.Views.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Cài Việt hóa" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding GamePathText}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.9" />
            <TextBlock Text="{Binding ContentText}" Margin="0,2,0,0" TextWrapping="Wrap" Opacity="0.9" />
            <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel>

        <ui:Card Grid.Row="1" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="1 · Chọn kiểu tên nhân vật" FontWeight="SemiBold" Margin="0,0,0,8" />
                <RadioButton GroupName="variant" IsChecked="{Binding VariantHanViet, Mode=TwoWay}"
                             Content="🇻🇳  Tên Hán Việt  (Kim Tịch, Trường Ly, Diễn Toán…)" Margin="0,2" />
                <RadioButton GroupName="variant" IsChecked="{Binding VariantEnglish, Mode=TwoWay}"
                             Content="🔤  Tên tiếng Anh  (Jinhsi, Changli, Yinlin…)" Margin="0,2" />
                <CheckBox IsChecked="{Binding ApplyFont, Mode=TwoWay}" IsEnabled="{Binding FontAvailable}"
                          Content="Cài kèm font tiếng Việt (khuyến nghị)" Margin="0,10,0,0" />
            </StackPanel>
        </ui:Card>

        <StackPanel Grid.Row="2">
        <ui:InfoBar IsOpen="True" Severity="Warning" Margin="0,0,0,10"
                    Title="Kiểm tra xung đột mod" Message="{Binding ConflictText}" />
        <ui:Card Padding="16" Margin="0,0,0,12" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="2 · Cài / Gỡ" FontWeight="SemiBold" Margin="0,0,0,10" />
                <WrapPanel>
                    <ui:Button Content="⬇  Cài Việt hóa" Appearance="Primary"
                               Command="{Binding InstallCommand}" Margin="0,0,10,8" MinWidth="150" />
                    <Button Content="🗑  Gỡ Việt hóa" Command="{Binding UninstallCommand}" Margin="0,0,10,8" />
                    <Button Content="🔎 Quét lại mod" Command="{Binding CheckConflictsCommand}" Margin="0,0,10,8" />
                    <Button Content="✖ Hủy" Command="{Binding CancelCommand}"
                            Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,0,10,8" />
                </WrapPanel>
                <TextBlock Text="⚠ TẮT GAME hoàn toàn trước khi cài. Sau khi cài: vào Cài đặt → Ngôn ngữ → Text = English, và chơi bằng DirectX 11."
                           TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,0" />
            </StackPanel>
        </ui:Card>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" />
            <TextBlock Text="{Binding ProgressText}" Opacity="0.8" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
