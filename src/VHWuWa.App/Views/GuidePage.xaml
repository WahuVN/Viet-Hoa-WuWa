<UserControl x:Class="VHWuWa.App.Views.GuidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Hướng dẫn sử dụng" FontSize="24" FontWeight="Bold" Margin="0,0,0,14" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <ui:TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Tìm hướng dẫn..." Margin="0,0,0,8" />
                <Button DockPanel.Dock="Bottom" Content="📂 Mở thư mục hướng dẫn"
                        Command="{Binding OpenFolderCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                <ListBox ItemsSource="{Binding Guides}" SelectedItem="{Binding Selected}" />
            </DockPanel>
            <ui:Card Grid.Column="1" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Margin" Value="0,2,0,2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="h1">
                                                    <Setter Property="FontSize" Value="22" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Margin" Value="0,6,0,8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="h2">
                                                    <Setter Property="FontSize" Value="18" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Margin" Value="0,12,0,4" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="h3">
                                                    <Setter Property="FontSize" Value="15" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Margin" Value="0,8,0,2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="li">
                                                    <Setter Property="Margin" Value="14,2,0,2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="quote">
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Setter Property="Opacity" Value="0.85" />
                                                    <Setter Property="Margin" Value="10,4,0,4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="space">
                                                    <Setter Property="MinHeight" Value="6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
