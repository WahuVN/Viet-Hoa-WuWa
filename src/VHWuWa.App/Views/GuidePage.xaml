<UserControl x:Class="VHWuWa.App.Views.GuidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Trợ giúp" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Chọn việc bạn cần làm, rồi thực hiện lần lượt theo từng bước."
                           Opacity="0.68" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Mở thư mục tài liệu" Command="{Binding OpenFolderCommand}"
                    Padding="11,6" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#142033" BorderBrush="#263b5a" BorderThickness="1" CornerRadius="8" Padding="11,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="12" Background="#2563eb"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="Chọn game" FontWeight="SemiBold" /><TextBlock Text="Tự tìm hoặc chọn thư mục Client" FontSize="11" Opacity="0.65" /></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="#142033" BorderBrush="#263b5a" BorderThickness="1" CornerRadius="8" Padding="11,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="12" Background="#2563eb"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="Cài Việt hóa" FontWeight="SemiBold" /><TextBlock Text="Chọn kiểu tên rồi bấm cài" FontSize="11" Opacity="0.65" /></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Background="#142033" BorderBrush="#263b5a" BorderThickness="1" CornerRadius="8" Padding="11,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="12" Background="#16a34a"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="Mở game" FontWeight="SemiBold" /><TextBlock Text="Đặt ngôn ngữ chữ là English" FontSize="11" Opacity="0.65" /></StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <ui:TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Tìm chủ đề…" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Guides}" SelectedItem="{Binding Selected}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="9,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding Summary}" FontSize="10.5" Opacity="0.58" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ui:Card Grid.Column="2" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="9" Background="#172a46" Margin="0,0,11,0">
                            <TextBlock Text="{Binding Selected.Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Selected.Title}" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="{Binding Selected.Summary}" FontSize="11" Opacity="0.62" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Separator Grid.Row="1" Margin="0,0,0,8" Opacity="0.35" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <ItemsControl ItemsSource="{Binding Blocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Margin" Value="0,2,0,2" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="CornerRadius" Value="7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="h1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="h2"><Setter Property="Margin" Value="0,12,0,4" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="h3"><Setter Property="Margin" Value="0,8,0,2" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="step">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Padding" Value="10,8" />
                                                        <Setter Property="Margin" Value="0,3,0,3" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="note">
                                                        <Setter Property="Background" Value="#12263a" />
                                                        <Setter Property="BorderBrush" Value="#28557c" />
                                                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                                                        <Setter Property="Padding" Value="10,8" />
                                                        <Setter Property="Margin" Value="0,6,0,6" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="code">
                                                        <Setter Property="Background" Value="#111318" />
                                                        <Setter Property="Padding" Value="9,5" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="space"><Setter Property="MinHeight" Value="5" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12.5" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="h2"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="#60a5fa" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="h3"><Setter Property="FontSize" Value="13.5" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="step"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="li"><Setter Property="Margin" Value="8,0,0,0" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="note"><Setter Property="Foreground" Value="#bfdbfe" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="code"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="Foreground" Value="#d1d5db" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
