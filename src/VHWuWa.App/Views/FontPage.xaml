<UserControl x:Class="VHWuWa.App.Views.FontPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,22">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Font chữ" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Chọn, xem thử và cài font tiếng Việt cho game."
                               Opacity="0.68" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#15233a" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                    <TextBlock Text="{Binding CurrentFont, StringFormat='Đang dùng: {0}'}"
                               Foreground="#60a5fa" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </Grid>

            <ProgressBar IsIndeterminate="True" Height="4"
                         Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />

            <ui:Card Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Font trong game" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.72" FontSize="12"
                                   Margin="0,3,12,0" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Cài gói .vhwpack" Command="{Binding ApplyCommand}" Margin="0,0,8,0" Padding="10,6" />
                        <Button Content="Khôi phục mặc định" Command="{Binding RestoreCommand}" Padding="10,6" />
                    </WrapPanel>
                </Grid>
            </ui:Card>

            <ui:Card Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Thư viện font" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding LibraryMessage}" Opacity="0.68" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Chọn font → xem trước → áp dụng"
                                   Opacity="0.55" FontSize="11" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Tìm font…" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedLibraryFont}"
                                  DisplayMemberPath="Display" Margin="0,0,8,0" Padding="8,5" />
                        <WrapPanel Grid.Column="2">
                            <ui:Button Content="{Binding ApplyButtonText}" Appearance="Primary"
                                       Command="{Binding ApplyLibraryFontCommand}" Margin="0,0,7,0" Padding="12,6" />
                            <Button Content="{Binding DownloadButtonText}" Command="{Binding DownloadFontOnlyCommand}"
                                    Visibility="{Binding ShowDownloadButton, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,7,0" Padding="10,6" />
                            <Button Content="Gỡ font" Command="{Binding RemoveFontCommand}" Padding="10,6" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Xem trước" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Kiểm tra kiểu chữ và dấu tiếng Việt trước khi cài."
                                       Opacity="0.68" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Chọn font ngoài" Command="{Binding PreviewFontCommand}" Margin="0,0,7,0" Padding="10,6" />
                            <Button Content="⛶ Xem lớn" Click="OpenLargePreview_Click" Margin="0,0,7,0" Padding="10,6" />
                            <ui:Button Content="Cài font ngoài" Appearance="Primary" Command="{Binding ApplyCustomFontCommand}"
                                       Visibility="{Binding HasCustomFontSelected, Converter={StaticResource BoolToVis}}" Padding="10,6" />
                        </WrapPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Nhập chữ mẫu…" />
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="−" Command="{Binding DecreasePreviewSizeCommand}" Width="30" Padding="0,4" />
                            <Slider Grid.Column="1" Minimum="12" Maximum="72" TickFrequency="2"
                                    IsSnapToTickEnabled="True" Value="{Binding PreviewFontSize, Mode=TwoWay}"
                                    Margin="8,0" VerticalAlignment="Center" ToolTip="Cỡ chữ xem trước" />
                            <Button Grid.Column="2" Content="+" Command="{Binding IncreasePreviewSizeCommand}" Width="30" Padding="0,4" />
                            <Button Grid.Column="3" Content="{Binding PreviewFontSizeLabel}" Command="{Binding ResetPreviewSizeCommand}"
                                    ToolTip="Đặt lại 30 px" MinWidth="54" Margin="7,0,0,0" Padding="6,4" />
                        </Grid>
                    </Grid>

                    <Border Background="#282A36" BorderBrush="#3F4454" BorderThickness="1"
                            CornerRadius="10" Padding="12" MinHeight="360" Height="380">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding PreviewImage}" Stretch="None"
                                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap"
                               Opacity="0.65" FontSize="11" Margin="2,7,0,0" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
