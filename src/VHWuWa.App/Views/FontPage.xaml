<UserControl x:Class="VHWuWa.App.Views.FontPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,22">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Font game" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Chọn font cho game và xem trước tiếng Việt."
                               Opacity="0.86" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#171A1F" CornerRadius="9" Padding="10,5" VerticalAlignment="Top">
                    <TextBlock Text="{Binding CurrentFont, StringFormat='Đang dùng: {0}'}"
                               Foreground="#B6C2CF" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </Grid>

            <ProgressBar IsIndeterminate="True" Height="4"
                         Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />

            <ui:Card Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Font đang dùng" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding Message}" TextWrapping="NoWrap" Opacity="0.84" FontSize="13"
                                   Margin="0,3,12,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Message}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Áp dụng" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApplyToGame}" Margin="0,0,8,0" Padding="10,6" />
                        <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Khôi phục" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanApplyToGame}" Padding="10,6" />
                    </WrapPanel>
                </Grid>
            </ui:Card>

            <ui:Card Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Thư viện font" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding LibraryMessage}" Opacity="0.86" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Chọn font muốn xem / áp dụng"
                                   Opacity="0.72" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Tìm font…" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedLibraryFont}"
                                  DisplayMemberPath="Display" Margin="0,0,8,0" Padding="8,5" />
                        <WrapPanel Grid.Column="2">
                            <ui:Button Content="{Binding ApplyButtonText}" Appearance="Primary"
                                       Command="{Binding ApplyLibraryFontCommand}" IsEnabled="{Binding CanApplyToGame}" Margin="0,0,7,0" Padding="12,6" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="{Binding DownloadButtonText}" Command="{Binding DownloadFontOnlyCommand}"
                                    Visibility="{Binding ShowDownloadButton, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,7,0" Padding="10,6" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Gỡ" Command="{Binding RemoveFontCommand}" IsEnabled="{Binding CanApplyToGame}" Padding="10,6" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Độ đậm font game" FontWeight="SemiBold" FontSize="15"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Chọn font chỉnh được" Command="{Binding SelectVariableFontCommand}"
                                    Margin="12,0,0,0" Padding="9,4" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding WeightLabel}" Foreground="#D7E0E8"
                                   FontWeight="SemiBold" FontSize="15" />
                    </Grid>
                    <Slider Minimum="{Binding MinimumFontWeight}" Maximum="{Binding MaximumFontWeight}"
                            Value="{Binding FontWeight, Mode=TwoWay}" TickFrequency="25"
                            IsSnapToTickEnabled="True" IsEnabled="{Binding CanAdjustFontWeight}"
                            VerticalAlignment="Center" Margin="2,0,2,8"
                            ToolTip="Chỉnh 100–900 với font biến thiên; chọn Lexend để sử dụng" />
                    <TextBlock Text="{Binding WeightHelp}" FontSize="12" Opacity="0.84" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Xem trước font game" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Mẫu hiển thị trong game · kiểm tra đủ dấu tiếng Việt."
                                       Opacity="0.86" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Chọn từ máy" Command="{Binding PreviewFontCommand}" Margin="0,0,7,0" Padding="10,6" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Xem lớn" Click="OpenLargePreview_Click" Margin="0,0,7,0" Padding="10,6" />
                            <ui:Button Content="Áp dụng font" Appearance="Primary" Command="{Binding ApplyCustomFontCommand}" IsEnabled="{Binding CanApplyToGame}"
                                       Visibility="{Binding HasCustomFontSelected, Converter={StaticResource BoolToVis}}" Padding="10,6" />
                        </WrapPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Nhập nội dung muốn thử…" />
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="−" Command="{Binding DecreasePreviewSizeCommand}" Width="30" Padding="0,4" />
                            <Slider Grid.Column="1" Minimum="12" Maximum="72" TickFrequency="2"
                                    IsSnapToTickEnabled="True" Value="{Binding PreviewFontSize, Mode=TwoWay}"
                                    Margin="8,0" VerticalAlignment="Center" ToolTip="Cỡ chữ xem trước" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Grid.Column="2" Content="+" Command="{Binding IncreasePreviewSizeCommand}" Width="30" Padding="0,4" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Grid.Column="3" Content="{Binding PreviewFontSizeLabel}" Command="{Binding ResetPreviewSizeCommand}"
                                    ToolTip="Đặt lại 30 px" MinWidth="54" Margin="7,0,0,0" Padding="6,4" />
                        </Grid>
                    </Grid>

                    <Border Background="#14171B" BorderBrush="#292D33" BorderThickness="1"
                            CornerRadius="9" Padding="12" MinHeight="230" Height="270">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding PreviewImage}" Stretch="None"
                                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap"
                               Opacity="0.82" FontSize="12" Margin="2,7,0,0" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
