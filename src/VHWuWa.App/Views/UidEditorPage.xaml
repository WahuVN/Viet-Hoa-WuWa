<UserControl x:Class="VHWuWa.App.Views.UidEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,18,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tiêu đề trang -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tên / Ẩn UID tài khoản" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Tùy chỉnh tên hiển thị hoặc ẩn hoàn toàn UID trong game để bảo vệ quyền riêng tư khi livestream, quay video và chụp ảnh."
                               Margin="0,3,0,0" Opacity="0.75" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="1" Background="#15233a" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
                    <TextBlock Text="🔒 Quyền riêng tư" Foreground="#38bdf8" FontWeight="SemiBold" FontSize="11" />
                </Border>
            </Grid>

            <!-- Card 1: Cấu hình nhanh Tên UID -->
            <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="🆔 Đặt tên cho UID" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="Mặc định: Để trống = Ẩn hoàn toàn UID"
                                   FontSize="11" Opacity="0.65" Margin="0,2,0,0" />
                    </StackPanel>

                    <ui:TextBox Grid.Column="2" Text="{Binding CustomUid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Để trống = Ẩn hoàn toàn UID (hoặc nhập tên vd: Việt Hóa WuWa)"
                                VerticalAlignment="Center" Padding="10,7" FontSize="13" />

                    <WrapPanel Grid.Column="4" VerticalAlignment="Center">
                        <ui:Button Content="💾 Lưu tên UID" Appearance="Primary" Command="{Binding SaveUidCommand}"
                                   Padding="13,7" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12" />
                        <Button Content="🔄 Đặt lại (Ẩn UID)" Command="{Binding ResetUidCommand}"
                                Padding="12,7" FontSize="12" ToolTip="Khôi phục về trạng thái ẩn UID bằng khoảng trắng mặc định" />
                    </WrapPanel>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Status}" TextWrapping="Wrap"
                               Margin="0,10,0,0" Opacity="0.85" FontSize="12" />
                </Grid>
            </ui:Card>

            <!-- Card 2: Banner nhắc cài đặt vào game sau khi tạo PAK -->
            <Border Grid.Row="2" Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                    Background="#0e2338" BorderBrush="#0284c7" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="⚡ ĐÃ TẠO XONG FILE PAK MỚI" FontWeight="Bold" FontSize="12" Foreground="#38bdf8" />
                        <TextBlock Text="{Binding InstallPromptMessage}" Margin="0,3,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#e0f2fe" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:Button Content="📥 Cài Việt hóa vào game" Appearance="{Binding ViAppearance}"
                                   Command="{Binding InstallViCommand}" Padding="12,7" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12" />
                        <ui:Button Content="📥 Cài Hán Việt vào game" Appearance="{Binding HvAppearance}"
                                   Command="{Binding InstallHvCommand}" Padding="12,7" FontWeight="SemiBold" FontSize="12" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Card 3: Chi tiết các vị trí bị ảnh hưởng trong game -->
            <ui:Card Grid.Row="3" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="📍 ĐỔI CHỖ NÀY THÌ Ở ĐÂU TRONG GAME BỊ ẢNH HƯỞNG?"
                               FontWeight="Bold" FontSize="13" Foreground="#f59e0b" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🖥️" FontSize="18" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="1. Góc dưới cùng bên phải màn hình khi chơi game (In-game HUD Watermark)"
                                       FontWeight="SemiBold" FontSize="12" Foreground="#38bdf8" />
                            <TextBlock Text="Dòng chữ UID mờ hiển thị liên tục ở góc dưới phải khi di chuyển trong game sẽ đổi thành nội dung bạn đặt (hoặc biến mất hoàn toàn nếu bạn chọn ẩn). Giúp chống lộ tài khoản khi stream hoặc quay clip."
                                       FontSize="11.5" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,6,0,8" Opacity="0.3" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🪪" FontSize="18" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="2. Thẻ Căn Cước / Menu Profile người chơi (Player Profile Card)"
                                       FontWeight="SemiBold" FontSize="12" Foreground="#38bdf8" />
                            <TextBlock Text="Dòng mã định danh UID: ... trong giao diện Menu chính (Esc / Rover) sẽ hiển thị theo chữ bạn tùy biến."
                                       FontSize="11.5" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,6,0,8" Opacity="0.3" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💬" FontSize="18" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="3. Khung Chat, Bạn bè &amp; Phòng kết nối Co-op (Co-op Lobby)"
                                       FontWeight="SemiBold" FontSize="12" Foreground="#38bdf8" />
                            <TextBlock Text="Các dòng hiển thị User ID: {0} và My UID: {0} trong danh sách kết nối nhiều người chơi sẽ được thay thế an toàn."
                                       FontSize="11.5" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,6,0,8" Opacity="0.3" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📷" FontSize="18" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="4. Chế độ Chụp ảnh màn hình (Photo Mode Watermark)"
                                       FontWeight="SemiBold" FontSize="12" Foreground="#38bdf8" />
                            <TextBlock Text="Watermark góc ảnh khi dùng tính năng chụp ảnh trong game sẽ tự động thay bằng tên bạn đặt."
                                       FontSize="11.5" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Card 4: Bảng đối chiếu 4 trường UID gốc của Game -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock Text="Chi tiết 4 trường UID trong Database game (Chỉnh sửa nâng cao)"
                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Items}" IsReadOnly="False" SelectionUnit="FullRow"
                              RowHeight="44" HeadersVisibility="Column" EnableRowVirtualization="True"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="中文 (CN gốc)" Binding="{Binding Cn}" Width="160" IsReadOnly="True" />
                            <DataGridTextColumn Header="English (EN gốc)" Binding="{Binding En}" Width="190" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Tiếng Việt (VI)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Vi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" Margin="3" Padding="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Hán Việt (HV)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Hv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" Margin="3" Padding="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>

            <!-- Nút lưu bảng chi tiết -->
            <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,6,0,0">
                <ui:Button Content="Lưu bảng chi tiết &amp; Tạo PAK" Appearance="Primary" Command="{Binding SaveBuildCommand}"
                           Padding="14,7" FontWeight="SemiBold" FontSize="12" />
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
