<UserControl x:Class="VHWuWa.App.Views.UidEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource Wahu.PageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,53,26,28" MaxWidth="1200" HorizontalAlignment="Stretch">
            <TextBlock Text="UID" FontFamily="{StaticResource WahuHeadingFontFamily}" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Ẩn hoặc thay thế UID"
                       Opacity="0.72" FontSize="12" Margin="0,5,0,18"/>

            <ui:Card Background="{DynamicResource Wahu.Surface}" BorderBrush="{DynamicResource Wahu.Border}" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Tên thay thế" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Background="{DynamicResource Wahu.InputBrush}" BorderBrush="{DynamicResource Wahu.Border}" Foreground="{DynamicResource Wahu.Text}" Grid.Column="0"
                                    Text="{Binding CustomUid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Để trống để ẩn UID"
                                    Padding="10,8" FontSize="13"
                                    VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Wahu.PrimaryButton}" Grid.Column="2" Content="Lưu và tạo PAK"
                                   Command="{Binding SaveUidCommand}" IsEnabled="{Binding CanEditBuild}" Padding="14,9"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource WahuStandardButtonStyle}" Grid.Column="4" Content="Ẩn UID" Command="{Binding ResetUidCommand}" IsEnabled="{Binding CanEditBuild}"
                                ToolTip="Đưa UID về trạng thái ẩn mặc định"
                                Padding="12,9" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusSummary}" FontSize="12" Opacity="0.8"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Status}" Margin="0,10,0,0"/>
                    <Border Margin="0,14,0,0" 
                            BorderThickness="0,1,0,0" Padding="0,11,0,0">
                        <TextBlock Text="Áp dụng: HUD · Hồ sơ · Chat/Co-op · Ảnh chụp"
                                   FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ui:Card>

            <Border Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Wahu.TableSurface}" BorderBrush="{DynamicResource Wahu.Border}" BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="PAK đã sẵn sàng" FontWeight="SemiBold"
                                   FontSize="14" Foreground="{DynamicResource Wahu.Muted}"/>
                        <TextBlock Text="{Binding InstallPromptMessage}"
                                   FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Wahu.Muted}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:Button Content="Cài Việt hóa" Appearance="{Binding ViAppearance}"
                                   Command="{Binding InstallViCommand}"
                                   Padding="12,8" Margin="0,0,8,0"/>
                        <ui:Button Content="Cài Hán Việt" Appearance="{Binding HvAppearance}"
                                   Command="{Binding InstallHvCommand}" Padding="12,8"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Expander Header="Chỉnh sửa nâng cao · 4 trường UID"
                      IsExpanded="False" Margin="0,0,0,12">
                <StackPanel Margin="10,12,10,8">
                    <TextBlock Text="CN/EN là bản gốc. Chỉ chỉnh VI/Hán Việt."
                               FontSize="12.5" Opacity="0.7" Margin="0,0,0,9"/>
                    <Border 
                            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <DataGrid VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                                  RowHeight="42" HeadersVisibility="Column"
                                  SelectionUnit="FullRow" IsReadOnly="False"
                                  EnableRowVirtualization="True"
                                  MaxHeight="300" MinHeight="130"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CN" Binding="{Binding Cn}"
                                                    Width="140" IsReadOnly="True" ElementStyle="{StaticResource Wahu.TableCellText}"/>
                                <DataGridTextColumn Header="EN" Binding="{Binding En}"
                                                    Width="180" IsReadOnly="True" ElementStyle="{StaticResource Wahu.TableCellText}"/>
                                <DataGridTemplateColumn Header="Tiếng Việt" Width="*"
                                                        MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource Wahu.EditorInput}" Text="{Binding Vi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center" Padding="6,4" Margin="3"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Hán Việt" Width="*"
                                                        MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource Wahu.EditorInput}" Text="{Binding Hv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center" Padding="6,4" Margin="3"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Style="{StaticResource Wahu.PrimaryButton}" Content="Lưu bảng và tạo PAK"
                               Command="{Binding SaveBuildCommand}" IsEnabled="{Binding CanEditBuild}" HorizontalAlignment="Right"
                               Padding="14,8" Margin="0,10,0,0"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
