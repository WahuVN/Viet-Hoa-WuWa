<UserControl x:Class="VHWuWa.App.Views.TermsEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource Wahu.PageBackground}">
    <Grid Margin="28,52,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Thuật ngữ" Foreground="{DynamicResource Wahu.Text}" FontFamily="{StaticResource WahuHeadingFontFamily}" FontSize="28" FontWeight="SemiBold" />
                
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Wahu.TableSurface}" BorderBrush="{DynamicResource Wahu.Border}"
                    BorderThickness="1" CornerRadius="9" Padding="12,6" VerticalAlignment="Center">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers><DataTrigger Binding="{Binding DirtyCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <TextBlock Text="{Binding DirtyCount, StringFormat='Đã sửa {0}'}" Foreground="{DynamicResource Wahu.Accent}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Wahu.Surface}" BorderBrush="#7E8786C9" BorderThickness="1" CornerRadius="11" Padding="12,7" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Nhóm" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ComboBox Style="{StaticResource Wahu.Dropdown}" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Padding="8,5">
                    <ComboBox.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Wahu.Text}" />
                    </DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                    <Expander Header="Khôi phục" IsExpanded="False" Margin="0,0,9,0">
                        <StackPanel Margin="8,6">
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Đặt lại nhóm" Command="{Binding ResetBuildCommand}" IsEnabled="{Binding CanEditBuild}"
                                    Padding="10,7" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Tải PAK gốc" Command="{Binding RestorePaksCommand}" IsEnabled="{Binding CanEditBuild}"
                                    Padding="10,7"/>
                        </StackPanel>
                    </Expander>
                    <Button Style="{StaticResource Wahu.PrimaryButton}" Content="Lưu và tạo PAK"
                               Command="{Binding SaveBuildCommand}" IsEnabled="{Binding CanEditBuild}"
                               Padding="12,8" FontWeight="SemiBold"/>
                </WrapPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding StatusSummary}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                           Margin="0,8,0,0" Opacity="0.82" FontSize="12" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Wahu.TableSurface}" BorderBrush="{DynamicResource Wahu.Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <DataGrid VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Items}" IsReadOnly="False" SelectionUnit="FullRow"
                      RowHeight="48" HeadersVisibility="Column" EnableRowVirtualization="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CN" Binding="{Binding Cn}" Width="125" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource Wahu.TableCellText}" />
                    <DataGridTemplateColumn Header="EN" Width="210" MinWidth="160" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding En}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="3,0,6,0" />
                                    <Button Style="{StaticResource WahuStandardButtonStyle}" Grid.Column="1" Content="Chép EN" ToolTip="Sao chép nguyên văn tiếng Anh"
                                            Command="{Binding DataContext.CopyEnglishCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Padding="4,2" FontSize="12" VerticalAlignment="Center" Opacity="0.85" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Tiếng Việt" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource Wahu.EditorInput}" Text="{Binding Vi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Center" Margin="3" Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Hán Việt (HV)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource Wahu.EditorInput}" Text="{Binding Hv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Center" Margin="3" Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Banner thông báo cài đặt sau khi tạo PAK -->
        <Border Grid.Row="3" Margin="0,10,0,0"
                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource Wahu.TableSurface}" BorderBrush="{DynamicResource Wahu.Border}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="PAK đã sẵn sàng" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Wahu.Muted}" />
                    <TextBlock Text="{Binding InstallPromptMessage}" Margin="0,3,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Wahu.Muted}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:Button Content="Cài Việt hóa" Appearance="{Binding ViAppearance}"
                               Command="{Binding InstallViCommand}" Padding="12,7" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12" />
                    <ui:Button Content="Cài Hán Việt" Appearance="{Binding HvAppearance}"
                               Command="{Binding InstallHvCommand}" Padding="12,7" FontWeight="SemiBold" FontSize="12" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
