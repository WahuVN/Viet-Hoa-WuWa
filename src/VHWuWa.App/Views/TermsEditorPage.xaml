<UserControl x:Class="VHWuWa.App.Views.TermsEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Thuật ngữ" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Chỉnh bản VI/Hán Việt theo từng nhóm."
                           Margin="0,3,0,0" Opacity="0.72" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
            <Border Grid.Column="1" Background="#171A1F" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                <TextBlock Text="{Binding DirtyCount, StringFormat='Đã sửa: {0}'}" Foreground="#B6C2CF" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <ui:Card Grid.Row="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Nhóm" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          DisplayMemberPath="Display" Padding="8,5" />
                <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                    <Expander Header="Khôi phục" IsExpanded="False" Margin="0,0,9,0">
                        <StackPanel Margin="8,6">
                            <Button Content="Đặt lại nhóm" Command="{Binding ResetBuildCommand}" IsEnabled="{Binding CanEditBuild}"
                                    Padding="10,7" Margin="0,0,0,6"/>
                            <Button Content="Tải PAK gốc" Command="{Binding RestorePaksCommand}" IsEnabled="{Binding CanEditBuild}"
                                    Padding="10,7"/>
                        </StackPanel>
                    </Expander>
                    <ui:Button Content="Lưu &amp; tạo PAK" Appearance="Secondary"
                               Command="{Binding SaveBuildCommand}" IsEnabled="{Binding CanEditBuild}"
                               Padding="12,8" FontWeight="SemiBold"/>
                </WrapPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding StatusSummary}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                           Margin="0,8,0,0" Opacity="0.82" FontSize="12" />
            </Grid>
        </ui:Card>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="7" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Items}" IsReadOnly="False" SelectionUnit="FullRow"
                      RowHeight="50" HeadersVisibility="Column" EnableRowVirtualization="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CN" Binding="{Binding Cn}" Width="125" MinWidth="90" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="EN" Width="210" MinWidth="160" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding En}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="3,0,6,0" />
                                    <Button Grid.Column="1" Content="Chép EN" ToolTip="Sao chép nguyên văn tiếng Anh"
                                            Command="{Binding DataContext.CopyEnglishCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Padding="4,2" FontSize="10" VerticalAlignment="Center" Opacity="0.85" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Tiếng Việt" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Vi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Center" Margin="3" Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Hán Việt (HV)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Hv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Center" Margin="3" Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Banner thông báo cài đặt sau khi tạo PAK -->
        <Border Grid.Row="3" Margin="0,10,0,0"
                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                Background="#171A1F" BorderBrush="#3A434D" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="PAK đã sẵn sàng" FontWeight="Bold" FontSize="12" Foreground="#B6C2CF" />
                    <TextBlock Text="{Binding InstallPromptMessage}" Margin="0,3,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#969DA6" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:Button Content="Cài Việt hóa" Appearance="{Binding ViAppearance}"
                               Command="{Binding InstallViCommand}" Padding="12,7" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12" />
                    <ui:Button Content="Cài Hán Việt" Appearance="{Binding HvAppearance}"
                               Command="{Binding InstallHvCommand}" Padding="12,7" FontWeight="SemiBold" FontSize="12" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
