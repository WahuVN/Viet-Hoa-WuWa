<UserControl x:Class="VHWuWa.App.Views.GraphicsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,24,26,28" MaxWidth="1120" HorizontalAlignment="Stretch">
            <TextBlock Text="Đồ họa" FontSize="24" FontWeight="Bold" Margin="0,0,0,7"/>
            <TextBlock Text="{Binding Message}" FontSize="12" Opacity="0.75"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Message}" Margin="0,0,0,18"/>

            <StackPanel Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}}">
                <ui:Card Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cấu hình nhanh" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,8,8" Padding="13,8"
                                            Command="{Binding DataContext.ApplyPresetCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="14" Margin="0,0,0,12">
                    <Expander Header="Tùy chỉnh nâng cao" IsExpanded="False">
                        <StackPanel Margin="10,10,10,8">
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Label}" Margin="0,0,10,0"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding Choices}"
                                                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                      Padding="9,6"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Content="Áp dụng tùy chỉnh" Appearance="Secondary"
                                       Command="{Binding ApplyCustomCommand}"
                                       HorizontalAlignment="Left" Padding="15,9"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Expander>
                </ui:Card>

                <ui:Card Padding="14" Margin="0,0,0,12">
                    <Expander Header="Tệp cấu hình &amp; khôi phục" IsExpanded="False">
                        <WrapPanel Margin="10,10,10,8">
                            <ui:Button Content="Khôi phục mặc định" Appearance="Secondary"
                                       Command="{Binding RestoreDefaultCommand}"
                                       Padding="12,8" Margin="0,0,8,8"/>
                            <Button Content="Đọc cấu hình" Command="{Binding ReadCurrentCommand}"
                                    Padding="12,8" Margin="0,0,8,8"/>
                            <Button Content="Mở tệp" Command="{Binding OpenConfigCommand}"
                                    Padding="12,8" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </Expander>
                </ui:Card>

                <ui:Card Padding="18">
                    <StackPanel>
                        <TextBlock Text="Bảo vệ cấu hình" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LockStatus}" FontSize="12" Opacity="0.8"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LockStatus}" Margin="0,6,0,12"/>
                        <WrapPanel>
                            <ui:Button Content="Khóa" Appearance="Secondary"
                                       Command="{Binding LockCommand}" Padding="14,8"
                                       ToolTip="Giữ thiết lập khi mở game"
                                       Margin="0,0,8,0"/>
                            <Button Content="Mở khóa" Command="{Binding UnlockCommand}"
                                    Padding="14,8" ToolTip="Cho phép game ghi lại cấu hình"/>
                        </WrapPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
