<UserControl x:Class="VHWuWa.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource Wahu.PageBackground}">
    <!-- Launcher-inspired dashboard. All actions remain bound to the existing real view models. -->
    <UserControl.Resources>
        <!-- Dedicated launcher tokens follow the selected theme, not static dark overrides. -->
        <Style x:Key="HomeGlassCard" TargetType="Border" BasedOn="{StaticResource Wahu.GlassCard}">
            <Setter Property="Background" Value="{DynamicResource Wahu.HomeCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Wahu.HomeBorder}"/>
        </Style>
        <SolidColorBrush x:Key="LauncherPanelBrush" Color="#A9192440" />
        <SolidColorBrush x:Key="LauncherTextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="LauncherMutedBrush" Color="#B5C3DE" />
        <Style x:Key="LauncherEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Wahu.HomeAccentText}" />
        </Style>
        <Style x:Key="LauncherSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Wahu.SecondaryButton}">
            <Setter Property="FontFamily" Value="{StaticResource WahuAppFontFamily}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{DynamicResource Wahu.HomeText}" />
            <Setter Property="Background" Value="{DynamicResource Wahu.HomeButton}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Wahu.HomeBorder}" />
        </Style>
        <!-- Buttons are real WPF controls, with focus/hover/press states. -->
        <Style x:Key="LauncherGameButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Wahu.SecondaryButton}">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="FontFamily" Value="{StaticResource WahuHeadingFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF9FF"/>
            <Setter Property="Background" Value="#D91D2B50"/>
            <Setter Property="BorderBrush" Value="#AE9DAFF5"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="GameSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5" CornerRadius="17" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GameSurface" Property="Background" Value="#EC344576"/>
                            <Setter TargetName="GameSurface" Property="BorderBrush" Value="#DDD1D3FF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GameSurface" Property="Background" Value="#E0141D38"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="GameSurface" Property="BorderBrush" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="GameSurface" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style x:Key="LauncherInstallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Wahu.PrimaryButton}">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontFamily" Value="{StaticResource WahuHeadingFontFamily}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background"><Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#48CBF2" Offset="0"/>
                    <GradientStop Color="#2BE6D2" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="30"
                            BorderThickness="1.6" BorderBrush="#9CF0FFFF" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#13A8D6" BlurRadius="13" ShadowDepth="0" Opacity="0.40"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#72F2EE"/>
                            <Setter TargetName="Pill" Property="BorderBrush" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#20B4D0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Pill" Property="Opacity" Value="0.60"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style x:Key="LauncherLinkButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Wahu.SecondaryButton}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#B8212C4D"/>
            <Setter Property="BorderBrush" Value="#818EA6D5"/>
            <Setter Property="Foreground" Value="#F1F2FF"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="LinkSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkSurface" Property="Background" Value="#E43A476E"/>
                            <Setter TargetName="LinkSurface" Property="BorderBrush" Value="#CDC9D8FF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="LinkSurface" Property="BorderBrush" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <!-- Full width indigo play action: original video/image remain untouched. -->
        <Style x:Key="LauncherPlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Wahu.SecondaryButton}">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="BorderBrush" Value="#9EB0D8F3"/>
            <Setter Property="Background"><Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#ED233452" Offset="0"/>
                    <GradientStop Color="#EE36527E" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PlaySurface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.3"
                            CornerRadius="18" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PlaySurface" Property="BorderBrush" Value="#F4F5FF"/>
                            <Setter TargetName="PlaySurface" Property="Background" Value="#F13B5782"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PlaySurface" Property="Background" Value="#F11C3151"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PlaySurface" Property="BorderBrush" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PlaySurface" Property="Opacity" Value="0.58"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="LauncherRoundButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Wahu.SecondaryButton}">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#C2151D31"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Circle" Background="{TemplateBinding Background}" BorderBrush="#688494B5" BorderThickness="1" CornerRadius="24">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#E62B3553"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Background" Value="#8C0B1932"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#EDF4FA" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#EDF4FA" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- Gently animated hero art, launcher-style. Pure WPF animation; no game hooks. -->
        <Image x:Name="LauncherHero" Source="/Assets/bg-fallback.png" Stretch="UniformToFill" IsHitTestVisible="False" />
        <!-- Real original 12s MP4 background. -->
        <MediaElement x:Name="LauncherBackgroundVideo" Stretch="UniformToFill"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True"
                      IsHitTestVisible="False" Opacity="0" />
        <!-- Original video remains; theme changes only lightweight overlay gradients. -->
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Wahu.HomeHeroHorizontalShade}" />
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Wahu.HomeHeroVerticalShade}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <Grid Margin="27,52,27,22" MinHeight="600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: immediately recognisable launcher branding and status. -->
                <Grid Grid.Row="0" Margin="0,0,0,19">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Width="52" Height="3" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{DynamicResource Wahu.Primary}" Margin="0,0,0,9" />
                        <TextBlock Text="Việt hóa PC" Foreground="#FFFFFF"
                                   FontFamily="{StaticResource WahuHeadingFontFamily}"
                                   FontSize="31" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="12"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource Wahu.HomeCard}" BorderBrush="{DynamicResource Wahu.HomeBorder}" BorderThickness="1"
                            Padding="14,9" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="BẢN DỊCH" Style="{StaticResource LauncherEyebrow}" />
                            <TextBlock Text="{Binding TranslationVersion}" Foreground="{DynamicResource Wahu.HomeText}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Left news/status panel, analogous to the official launcher cards. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="308" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <Border Style="{StaticResource HomeGlassCard}" Padding="17,14">
                            <StackPanel>
                                <TextBlock Text="TRẠNG THÁI" Style="{StaticResource LauncherEyebrow}" />
                                <TextBlock Text="{Binding TranslationStatus}" Foreground="{DynamicResource Wahu.HomeText}"
                                           FontFamily="{StaticResource WahuHeadingFontFamily}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" />
                                <TextBlock Text="{Binding StagedContentText}" Foreground="{DynamicResource Wahu.HomeMuted}"
                                           TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasStagedContent}" Value="True" />
                                                        <Condition Binding="{Binding PathOk}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Visibility="{Binding PathOk, Converter={StaticResource BoolToVis}}">
                                    <Border Height="1" Background="{DynamicResource Wahu.HomeBorder}" Margin="0,11,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Phiên bản" Foreground="{DynamicResource Wahu.HomeMuted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding DetectedVersion}"
                                               Foreground="{DynamicResource Wahu.HomeText}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kiểu tên" Foreground="{DynamicResource Wahu.HomeMuted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentVariant}"
                                               Foreground="{DynamicResource Wahu.HomeText}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HomeGlassCard}" Margin="0,10,0,0" Padding="15,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ĐƯỜNG DẪN GAME" Style="{StaticResource LauncherEyebrow}" />
                                    <TextBlock Grid.Column="1" Text="{Binding PathStatus}"
                                               Foreground="{DynamicResource Wahu.HomeMuted}" FontSize="12"
                                               MaxWidth="132" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathStatus}" />
                                </Grid>
                                <ui:TextBox Text="{Binding GamePath}" IsReadOnly="True"
                                            PlaceholderText="Chưa tìm thấy game" FontSize="12.5"
                                            Foreground="{DynamicResource Wahu.HomeText}" Background="{DynamicResource Wahu.HomeInput}"
                                            BorderBrush="{DynamicResource Wahu.HomeBorder}"
                                            Margin="0,8,0,9" />
                                <WrapPanel>
                                    <Button Style="{StaticResource LauncherSecondaryButton}"
                                            Command="{Binding AutoDetectCommand}" Margin="0,0,6,6"
                                            Padding="10,7">
                                        <TextBlock Text="Tự tìm" Foreground="{DynamicResource Wahu.HomeText}" FontSize="12.5" FontWeight="Medium"/>
                                    </Button>
                                    <Button Style="{StaticResource LauncherSecondaryButton}"
                                            Command="{Binding ChooseFolderCommand}" Margin="0,0,6,6"
                                            Padding="10,7">
                                        <TextBlock Text="Chọn thư mục" Foreground="{DynamicResource Wahu.HomeText}" FontSize="12.5" FontWeight="Medium"/>
                                    </Button>
                                    <Button Style="{StaticResource LauncherSecondaryButton}"
                                            Command="{Binding OpenFolderCommand}" Margin="0,0,0,6"
                                            Padding="10,7">
                                        <TextBlock Text="Mở thư mục" Foreground="{DynamicResource Wahu.HomeText}" FontSize="12.5" FontWeight="Medium"/>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Padding="14,10" CornerRadius="12"
                                Background="{DynamicResource Wahu.HomeCard}" BorderBrush="{DynamicResource Wahu.HomeBorder}" BorderThickness="1"
                                Visibility="{Binding Main.HasUpdate, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Main.LatestVersion, StringFormat='Ứng dụng có bản mới v{0}'}"
                                           Foreground="{DynamicResource Wahu.HomeText}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Main.UpdateNotes}" Foreground="{DynamicResource Wahu.HomeMuted}"
                                           FontSize="12.5" TextWrapping="Wrap" MaxHeight="72" Margin="0,4,0,9" />
                                <Button Command="{Binding Main.ApplyUpdateCommand}"
                                        Style="{StaticResource LauncherSecondaryButton}" HorizontalAlignment="Left">
                                    <TextBlock Text="Cập nhật ứng dụng" Foreground="{DynamicResource Wahu.HomeText}" FontSize="12.5"/>
                                </Button>
                                <ProgressBar Value="{Binding Main.UpdateProgress}" Maximum="100" Height="4"
                                             Margin="0,7,0,0"
                                             Visibility="{Binding Main.IsUpdating, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Actual installer commands live in the existing InstallViewModel. -->
                <Grid x:Name="InstallPanel" Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="308" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="378" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource HomeGlassCard}" Padding="16,13" VerticalAlignment="Bottom">
                        <StackPanel>
                            <TextBlock Text="TÊN NHÂN VẬT" Style="{StaticResource LauncherEyebrow}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Wahu.Radio}" GroupName="home-name-variant"
                                             IsChecked="{Binding VariantEnglish, Mode=TwoWay}" Margin="0,0,17,0">
                                    <TextBlock Text="Tiếng Anh" Foreground="{DynamicResource Wahu.HomeText}"/>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Wahu.Radio}" GroupName="home-name-variant"
                                             IsChecked="{Binding VariantHanViet, Mode=TwoWay}"
                                             IsEnabled="{Binding IsHanVietAvailable}"
                                             ToolTipService.ShowOnDisabled="True"
                                             ToolTip="{Binding OptionHelpText}">
                                    <TextBlock Text="Hán Việt" Foreground="{DynamicResource Wahu.HomeText}"/>
                                </RadioButton>
                            </StackPanel>
                            <Button Style="{StaticResource LauncherSecondaryButton}"
                                    Command="{Binding DownloadHanVietCommand}"
                                    Visibility="{Binding ShowHanVietDownload, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,5">
                                <TextBlock Text="{Binding HanVietDownloadBtnText}" Foreground="{DynamicResource Wahu.HomeText}" FontSize="12.5"/>
                            </Button>
                            <CheckBox IsChecked="{Binding ApplyFont, Mode=TwoWay}"
                                      ToolTip="{Binding OptionHelpText}" Margin="0,12,0,0">
                                <CheckBox.Style>
                                    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource Wahu.Checkbox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsesNativeFont}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                                <TextBlock Text="Kèm font tiếng Việt" Foreground="{DynamicResource Wahu.HomeText}" FontSize="12.5"/>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                        Visibility="{Binding UsesNativeFont, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Wahu.HomeAccentText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Font game mặc định" ToolTip="R29 dùng font gốc của game; không cài PAK font ghi đè." Foreground="{DynamicResource Wahu.HomeText}"
                                           FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Responsive, actionable launcher CTA; artwork is not a flattened bitmap. -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,7,17" IsHitTestVisible="False"
                                    Visibility="{Binding DataContext.ShowFeaturedSeasonTitle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="Bách Hợp Giữa Mộng Tàn">
                            <TextBlock Text="{Binding DataContext.FeaturedReleaseLineOne, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                       FontFamily="Cambria" FontStyle="Italic" FontWeight="Bold"
                                       FontSize="38" Foreground="#FFF9FF" TextAlignment="Right"
                                       HorizontalAlignment="Right" TextOptions.TextFormattingMode="Ideal">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#1A103C" BlurRadius="4" ShadowDepth="1" Opacity="0.96"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding DataContext.FeaturedReleaseLineTwo, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                       FontFamily="Cambria" FontStyle="Italic" FontWeight="Bold"
                                       FontSize="34" TextAlignment="Right" HorizontalAlignment="Right"
                                       TextOptions.TextFormattingMode="Ideal">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#F1E6FF" Offset="0.55"/>
                                        <GradientStop Color="#D9B9FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#221242" BlurRadius="4" ShadowDepth="1" Opacity="0.96"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <!-- Lightweight native WPF ornament; never covers the video or steals clicks. -->
                            <Grid Height="15" Width="265" HorizontalAlignment="Right" Margin="0,8,3,0">
                                <Border Height="1" VerticalAlignment="Center" CornerRadius="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00D7B8FF" Offset="0"/>
                                            <GradientStop Color="#C6D4BCFF" Offset="0.48"/>
                                            <GradientStop Color="#BD9EEAFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="✦" Foreground="#F3D8FF" Background="#60212A52"
                                           FontSize="16" FontFamily="Segoe UI Symbol"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="6,0"/>
                                <Border Background="#B51C2948" CornerRadius="6" Padding="6,1"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DataContext.FeaturedReleaseBadge, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               Foreground="#F7ECFF" FontFamily="{StaticResource WahuAppFontFamily}"
                                               FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Clear three-action workflow with grounded state; no game hooks changed. -->
                        <Border Background="#B31B2946" BorderBrush="#77C6D5F0" BorderThickness="1"
                                CornerRadius="20" Padding="11,10,11,11" SnapsToDevicePixels="True">
                            <StackPanel>
                                <Grid Margin="2,0,2,9">
                                    <TextBlock Text="CHỌN  ·  CÀI  ·  CHƠI"
                                               Foreground="#E7EAFB" FontWeight="SemiBold" FontSize="11"
                                               FontFamily="{StaticResource WahuAppFontFamily}" VerticalAlignment="Center"/>
                                    <TextBlock HorizontalAlignment="Right" Foreground="#D4F4FC"
                                               FontWeight="Medium" FontSize="11" VerticalAlignment="Center"
                                               FontFamily="{StaticResource WahuAppFontFamily}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Chưa chọn game"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.PathOk, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                        <Setter Property="Text" Value="Đã nhận game"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                        <Setter Property="Text" Value="Sẵn sàng chơi"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <!-- Dedicated two-button row: same action labels and handlers, never swap modes. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="146"/>
                                        <ColumnDefinition Width="11"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="ChooseGameFolderFromInstall"
                                            ToolTip="Bước 1: Chọn thư mục game PC chứa Client."
                                            AutomationProperties.Name="Chọn game"
                                            Style="{StaticResource LauncherGameButton}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="M 6.5,7 C 4.6,7 3.3,8.4 3.1,10.2 L 2.7,15.6 C 2.5,18 4.4,19 6,17.7 L 9.2,15 H 14.8 L 18,17.7 C 19.6,19 21.5,18 21.3,15.6 L 20.9,10.2 C 20.7,8.4 19.4,7 17.5,7 Z M 7,10 L 7,14 M 5,12 L 9,12 M 16,11 L 16,11.2 M 18,13 L 18,13.2"
                                                  Width="21" Height="21" Stretch="Uniform" Stroke="#F3EFFF" StrokeThickness="1.8"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Chọn game" FontFamily="{StaticResource WahuHeadingFontFamily}"
                                                       Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Click="InstallFromHome"
                                            ToolTip="Bước 2: Cài Việt hóa. Nếu chưa có game, ứng dụng sẽ mở hộp thoại chọn thư mục trước."
                                            AutomationProperties.Name="Cài Việt hóa"
                                            Style="{StaticResource LauncherInstallButton}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="M 12,3 L 12,15 M 7,10 L 12,15 L 17,10 M 4,17 L 4,20 L 20,20 L 20,17"
                                                  Width="23" Height="23" Stretch="Uniform" Stroke="#0B2A48" StrokeThickness="2.5"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Fill="Transparent" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Cài Việt hóa" FontFamily="{StaticResource WahuHeadingFontFamily}"
                                                       Foreground="#0C2743" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Third step matches the 60px height of the first two choices. -->
                                <Grid Margin="0,9,0,0">
                                    <Button Style="{StaticResource LauncherPlayButton}" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            ToolTip="Mở Wuthering Waves qua launcher chính thức hoặc Steam; bấm Start để chơi."
                                            AutomationProperties.Name="Mở game Wuthering Waves">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="12" Background="#634C72A8"
                                                    BorderBrush="#83CDD6FF" BorderThickness="1" VerticalAlignment="Center">
                                                <Path Data="M 8,5.8 L 19.5,12 L 8,18.2 Z"
                                                      Width="19" Height="19" Stretch="Uniform" Fill="#FFFFFF"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0,0,0"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="13,0,5,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.LaunchButtonText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                           Foreground="#FFFFFF" FontFamily="{StaticResource WahuHeadingFontFamily}"
                                                           FontSize="17" FontWeight="Bold"/>
                                                <TextBlock Foreground="#DBE7FA" FontFamily="{StaticResource WahuAppFontFamily}"
                                                           FontSize="11.5" Margin="0,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Qua launcher · nhấn Start"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.PathOk, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                                                                    <Setter Property="Text" Value="Chọn thư mục game trước"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="30" Height="30" CornerRadius="15"
                                                    Background="#3DA8C2E4" VerticalAlignment="Center">
                                                <Path Data="M 6,12 L 18,12 M 13,7 L 18,12 L 13,17"
                                                      Width="18" Height="18" Stretch="Uniform" Stroke="#F2F7FF"
                                                      StrokeThickness="2" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding UninstallCommand}"
                                Visibility="{Binding DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource LauncherSecondaryButton}" MinHeight="30"
                                Padding="8,4" FontSize="12.5" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock Text="Gỡ Việt hóa" Foreground="{DynamicResource Wahu.HomeText}" FontSize="12"/>
                        </Button>
                        <Grid Margin="0,8,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Image x:Name="InstallProgressGif" Grid.Column="0" Width="23" Height="23" Stretch="Uniform" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Value="{Binding Progress}" Maximum="100" Height="5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding ProgressText}" Foreground="#E5EAF7" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                        <Button Command="{Binding CancelCommand}" Style="{StaticResource LauncherSecondaryButton}"
                                HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Hủy" Foreground="{DynamicResource Wahu.HomeText}" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Wahu.HomeText}"
                               Visibility="{Binding PathOk, Converter={StaticResource BoolToVis}}"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               FontSize="12.5" MaxWidth="640" />
                    <Button Grid.Column="1"
                            Visibility="{Binding PathOk, Converter={StaticResource BoolToVis}}"
                            Command="{Binding KillGameProcessesCommand}"
                            Style="{StaticResource LauncherSecondaryButton}"
                            ToolTip="Đóng game trong thư mục đã chọn. Không tắt launcher hoặc Steam; buộc dừng cần xác nhận riêng."
                            Padding="10,7" Margin="12,0,0,0">
                        <TextBlock Text="Đóng game…" Foreground="{DynamicResource Wahu.HomeText}" FontSize="12"/>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
