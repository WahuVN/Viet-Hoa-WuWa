<UserControl x:Class="VHWuWa.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Giao diện QA: thay đổi trình bày, giữ nguyên toàn bộ bindings/commands cài đặt. -->
    <UserControl.Resources>
        <Style x:Key="WuwaSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="WuwaCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,24,26,28" MaxWidth="1240" HorizontalAlignment="Stretch">

            <!-- Mở đầu trực quan: phiên bản dịch và tình trạng thật qua binding. -->
            <Border CornerRadius="10" BorderThickness="1"
                    BorderBrush="#3A434D" Padding="18,14"
                    Margin="0,0,0,16">
                <Border.Background><SolidColorBrush Color="#14171B" /></Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tổng quan"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="#F1F3F5" />
                        <TextBlock Text="Game · Bản dịch · Cập nhật"
                                   FontSize="11" Foreground="#969DA6"
                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#171A1F"
                            BorderBrush="#292D33" BorderThickness="1"
                            CornerRadius="9" Padding="14,11"
                            VerticalAlignment="Center" Margin="18,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Trạng thái"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#969DA6" />
                            <TextBlock Text="{Binding TranslationStatus}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#F1F3F5" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding TranslationVersion}"
                                       FontSize="11" Foreground="#969DA6"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Margin="0,0,0,14" Padding="15,13"
                    CornerRadius="9" Background="#171A1F"
                    BorderBrush="#3A434D" BorderThickness="1"
                    Visibility="{Binding HasStagedContent, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="PAK Việt hóa PC" FontSize="13" FontWeight="SemiBold" Foreground="#F1F3F5"/>
                    <TextBlock Text="{Binding StagedContentText}" Margin="0,5,0,0"
                               FontSize="12" TextWrapping="Wrap" Foreground="#B6C2CF"/>
                </StackPanel>
            </Border>

            <!-- Luồng nâng app độc lập với màn cài Việt hóa: giữ command hiện hữu. -->
            <Border Margin="0,0,0,14" Padding="15,14"
                    CornerRadius="9" Background="#171A1F"
                    BorderBrush="#3A434D" BorderThickness="1"
                    Visibility="{Binding Main.HasUpdate, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Main.LatestVersion, StringFormat='Có bản cập nhật ứng dụng v{0}'}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#F1F3F5" />
                        <TextBlock Text="{Binding Main.UpdateNotes}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="35" FontSize="11" Foreground="#969DA6"
                                   Margin="0,4,0,0" />
                        <ProgressBar Value="{Binding Main.UpdateProgress}"
                                     Maximum="100" Height="4" Margin="0,10,0,0"
                                     Visibility="{Binding Main.IsUpdating, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Cập nhật ứng dụng"
                               Appearance="Secondary" Command="{Binding Main.ApplyUpdateCommand}"
                               Margin="16,0,0,0" Padding="15,9" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Hai tác vụ thường dùng, không cần lồng nhiều lớp card. -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Card Grid.Column="0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Mở game" Style="{StaticResource WuwaCardTitle}"
                                   Margin="0,0,0,14" />
                        <WrapPanel Margin="0,0,0,13">
                            <ui:Button Content="Mở launcher" Command="{Binding LaunchGameCommand}"
                                       Appearance="Secondary" Height="40" MinWidth="136"
                                       Padding="15,8" Margin="0,0,8,6"
                                       ToolTip="Mở launcher Kuro chính thức." />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Tắt game" Command="{Binding KillGameProcessesCommand}"
                                    Height="40" Padding="13,8" Margin="0,0,0,6"
                                    ToolTip="Đóng game và launcher trước khi cài đặt." />
                        </WrapPanel>
                        <Separator Opacity="0.32" Margin="0,0,0,11" />
                        <WrapPanel>
                            <TextBlock Text="Phiên bản game" Foreground="#969DA6"
                                       FontSize="11" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding DetectedVersion}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" />
                            <TextBlock Text="Tên nhân vật" Foreground="#969DA6"
                                       FontSize="11" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding CurrentVariant}"
                                       FontSize="11" FontWeight="SemiBold" />
                        </WrapPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Đường dẫn game" Style="{StaticResource WuwaCardTitle}" />
                            <TextBlock Grid.Column="1" Text="{Binding PathStatus}"
                                       FontSize="11" Foreground="#B6C2CF"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ui:TextBox Text="{Binding GamePath}" IsReadOnly="True"
                                    PlaceholderText="Chưa tìm thấy game"
                                    FontSize="12" Margin="0,0,0,12" />
                        <WrapPanel>
                            <ui:Button Content="Tự tìm game" Command="{Binding AutoDetectCommand}"
                                       Appearance="Secondary" Padding="12,7" Margin="0,0,7,6" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Chọn thư mục" Command="{Binding ChooseFolderCommand}"
                                    Padding="10,7" Margin="0,0,7,6" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Mở" Command="{Binding OpenFolderCommand}"
                                    Padding="10,7" Margin="0,0,7,6" />
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Kiểm tra" Command="{Binding CheckFilesCommand}"
                                    Padding="10,7" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Một hành động cài chính, rõ ràng về biến thể và tùy chọn font. -->
            <StackPanel x:Name="InstallPanel">
                <ui:Card Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cài Việt hóa"
                                           FontSize="20" FontWeight="Bold" Foreground="#F1F3F5" />
                                <TextBlock Text="{Binding StatusText}" Margin="0,7,0,0"
                                           TextWrapping="Wrap" Foreground="#B6C2CF"
                                           FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kiểu tên" Style="{StaticResource WuwaCardTitle}"
                                           FontSize="14" Margin="0,0,0,9" />
                                <RadioButton GroupName="variant" Content="Tên Anh"
                                             IsChecked="{Binding VariantEnglish, Mode=TwoWay}"
                                             FontSize="13" Margin="0,4,0,7" />
                                <RadioButton GroupName="variant" Content="Tên Hán Việt"
                                             IsEnabled="{Binding IsHanVietAvailable}"
                                             ToolTip="R29 chưa có PAK Hán Việt tương thích game PC 3.8.11."
                                             IsChecked="{Binding VariantHanViet, Mode=TwoWay}"
                                             FontSize="13" Margin="0,3,0,7" />
                                <Button Style="{StaticResource WahuStandardButtonStyle}" Content="{Binding HanVietDownloadBtnText}"
                                        Command="{Binding DownloadHanVietCommand}"
                                        Visibility="{Binding ShowHanVietDownload, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Left" Margin="20,0,0,8"
                                        Padding="10,6" FontSize="11" />
                                <CheckBox IsChecked="{Binding ApplyFont, Mode=TwoWay}"
                                          IsEnabled="{Binding FontAvailable}"
                                          ToolTip="R29 đang dùng Mount không hỗ trợ cài PAK font riêng; chỉ bật khi có gói font tương thích."
                                          Content="Cài font tiếng Việt" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="#292D33"
                                    HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cài vào game" Style="{StaticResource WuwaCardTitle}"
                                           FontSize="14" Margin="0,0,0,8" />
                                <TextBlock Text="Đóng game trước khi cài. Ứng dụng sẽ sao lưu và kiểm tra tệp."
                                           Foreground="#969DA6" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,14" />
                                <ui:Button Content="{Binding InstallButtonText}"
                                           Appearance="Primary" Command="{Binding InstallCommand}"
                                           Padding="18,10" MinHeight="44" FontSize="14" FontWeight="SemiBold"
                                           ToolTip="Chỉ cài khi game, PAK và loader đã được xác minh tương thích."
                                           AutomationProperties.Name="Cài Việt hóa vào game"
                                           HorizontalAlignment="Stretch" Margin="0,0,0,9" />
                                <Expander Header="Tùy chọn nâng cao" IsExpanded="False">
                                    <WrapPanel Margin="8,8,8,6">
                                        <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Kiểm tra xung đột"
                                                Command="{Binding CheckConflictsCommand}"
                                                Margin="0,0,8,6" Padding="10,7" />
                                        <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Gỡ Việt hóa"
                                                Command="{Binding UninstallCommand}"
                                                Margin="0,0,0,6" Padding="10,7" />
                                    </WrapPanel>
                                </Expander>
                                <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Hủy" Command="{Binding CancelCommand}"
                                        Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Left" Margin="0,9,0,0" Padding="11,7" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="7"
                                     Margin="0,18,0,0"
                                     Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ProgressText}"
                                   Foreground="#969DA6" FontSize="12"
                                   Margin="0,7,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <ui:InfoBar IsOpen="True" Severity="Informational"
                        Message="{Binding Message}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
