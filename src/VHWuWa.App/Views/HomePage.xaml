<UserControl x:Class="VHWuWa.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20">
            <!-- Header gọn gàng -->
            <TextBlock Text="Trang chủ" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Quản lý bản Việt hóa Wuthering Waves · Game 3.6" Opacity="0.65" FontSize="13" Margin="0,2,0,16" />

            <!-- Banner Cập nhật tinh gọn chuẩn Linear/GitHub -->
            <Border Background="#102619" BorderBrush="#1e5233" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                    Visibility="{Binding Main.HasUpdate, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟢" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Main.LatestVersion, StringFormat='Đã có bản cập nhật mới v{0}'}"
                                       FontWeight="SemiBold" FontSize="13" Foreground="#4ade80" />
                        </StackPanel>
                        <TextBlock Text="{Binding Main.UpdateNotes}" Opacity="0.8" TextWrapping="Wrap" Margin="16,2,0,0" FontSize="12" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Value="{Binding Main.UpdateProgress}" Maximum="100" Height="4" Margin="16,6,0,0"
                                     Visibility="{Binding Main.IsUpdating, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="⬇ Cập nhật ngay" Appearance="Primary" Margin="12,0,0,0"
                               FontWeight="SemiBold" FontSize="12" Padding="12,6"
                               VerticalAlignment="Center" Command="{Binding Main.ApplyUpdateCommand}" />
                </Grid>
            </Border>

            <!-- Card Thông tin trạng thái -->
            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Trạng thái hệ thống" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition Height="8" />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Tên game" Opacity="0.6" Margin="0,2" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GameName}" Margin="8,2" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Row="1" Text="Phiên bản game" Opacity="0.6" Margin="0,2" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetectedVersion}" Margin="8,2" FontSize="12" />
                        <TextBlock Grid.Row="2" Text="Đường dẫn game" Opacity="0.6" Margin="0,2" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PathStatus}" Margin="8,2" TextWrapping="Wrap" FontSize="12" />

                        <Separator Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,2" Opacity="0.4" />

                        <TextBlock Grid.Row="4" Text="Trạng thái Việt hóa" Opacity="0.6" Margin="0,2" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TranslationStatus}" Margin="8,2" FontWeight="SemiBold" FontSize="12" Foreground="#4ade80" />
                        <TextBlock Grid.Row="5" Text="Phiên bản cài đặt" Opacity="0.6" Margin="0,2" FontSize="12" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TranslationVersion}" Margin="8,2" FontSize="12" />
                        <TextBlock Grid.Row="6" Text="Kiểu tên nhân vật" Opacity="0.6" Margin="0,2" FontSize="12" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CurrentVariant}" Margin="8,2" FontSize="12" />
                        <TextBlock Grid.Row="7" Text="Font chữ đang dùng" Opacity="0.6" Margin="0,2" FontSize="12" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CurrentFont}" Margin="8,2" FontSize="12" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Card Thư mục game -->
            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Thư mục cài đặt game" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                    <ui:TextBox Text="{Binding GamePath}" PlaceholderText="Ví dụ: D:\Game\Wuthering Waves Game" IsReadOnly="True" Margin="0,0,0,10" FontSize="12" />
                    <WrapPanel>
                        <ui:Button Content="🔍 Tự tìm game" Appearance="Primary" Command="{Binding AutoDetectCommand}" Margin="0,0,8,6" Padding="12,6" FontSize="12" />
                        <Button Content="📁 Chọn thư mục" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,6" Padding="10,6" FontSize="12" />
                        <Button Content="📂 Mở thư mục" Command="{Binding OpenFolderCommand}" Margin="0,0,8,6" Padding="10,6" FontSize="12" />
                        <Button Content="✔ Kiểm tra file" Command="{Binding CheckFilesCommand}" Margin="0,0,8,6" Padding="10,6" FontSize="12" />
                        <ui:Button Content="🛑 Tắt game" Appearance="Danger" Command="{Binding KillGameProcessesCommand}" Margin="0,0,8,6" Padding="10,6" FontSize="12" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
