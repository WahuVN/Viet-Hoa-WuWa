<UserControl x:Class="VHWuWa.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,22">
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Trang chủ" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Mở game và xem nhanh trạng thái Việt hóa."
                           FontSize="12" Opacity="0.7" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Chỉ hiện khi có bản mới, dùng màu chuẩn của giao diện -->
            <ui:Card Padding="14" Margin="0,0,0,12"
                     Visibility="{Binding Main.HasUpdate, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Main.LatestVersion, StringFormat='Có bản cập nhật v{0}'}"
                                   FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Main.UpdateNotes}" FontSize="11" Opacity="0.68"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"
                                   Margin="0,2,0,0" />
                        <ProgressBar Value="{Binding Main.UpdateProgress}" Maximum="100" Height="4"
                                     Margin="0,7,0,0"
                                     Visibility="{Binding Main.IsUpdating, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Cập nhật" Appearance="Primary"
                               Command="{Binding Main.ApplyUpdateCommand}" Margin="14,0,0,0"
                               Padding="14,7" VerticalAlignment="Center" />
                </Grid>
            </ui:Card>

            <!-- Khu vực chính: ít khung, hai hành động rõ ràng -->
            <ui:Card Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="230" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="Wuthering Waves" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Mở trực tiếp bằng thiết lập hiện tại."
                                       FontSize="12" Opacity="0.65" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button Content="{Binding LaunchButtonText}" Appearance="Primary"
                                       Command="{Binding LaunchGameCommand}" MinWidth="145"
                                       Padding="18,10" Margin="0,0,8,0" FontSize="13"
                                       FontWeight="SemiBold" ToolTip="Mở Client-Win64-Shipping.exe" />
                            <ui:Button Content="Tắt game" Appearance="Danger"
                                       Command="{Binding KillGameProcessesCommand}" MinWidth="104"
                                       Padding="16,10" FontSize="13"
                                       ToolTip="Đóng tiến trình game đang chạy" />
                        </WrapPanel>
                    </Grid>

                    <Separator Margin="0,15,0,11" Opacity="0.45" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Việt hóa" FontSize="11" Opacity="0.55" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding TranslationStatus}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Phiên bản" FontSize="11" Opacity="0.55" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding TranslationVersion}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <TextBlock Text="Game" FontSize="11" Opacity="0.55" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DetectedVersion}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <Expander Margin="0,10,0,0">
                        <Expander.Header>
                            <TextBlock Text="Tùy chọn khởi chạy" FontSize="12" />
                        </Expander.Header>
                        <StackPanel Margin="20,8,0,2">
                            <CheckBox Content="Môi trường C# thử nghiệm"
                                      IsChecked="{Binding ForceCSharpEnvironment, Mode=TwoWay}"
                                      FontSize="12" Margin="0,0,0,8"
                                      ToolTip="Lần đầu có thể tải thêm dữ liệu. Nếu game không ổn định, hãy tắt tùy chọn này." />
                            <Button Content="Chép tham số Steam"
                                    Command="{Binding CopyCSharpArgumentCommand}"
                                    HorizontalAlignment="Left" Padding="10,5" FontSize="11" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ui:Card>

            <!-- Thiết lập hiện tại và thư mục game dùng chung một mặt phẳng -->
            <ui:Card Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="210" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="3*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Thiết lập hiện tại" FontWeight="SemiBold" FontSize="14"
                                   Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Kiểu tên" FontSize="11" Opacity="0.58" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVariant}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="6,3" />
                            <TextBlock Grid.Row="1" Text="Font chữ" FontSize="11" Opacity="0.58" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentFont}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="6,3" />
                            <TextBlock Grid.Row="2" Text="Tên game" FontSize="11" Opacity="0.58" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GameName}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="6,3" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1,0,0,0" Margin="10,0" />

                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thư mục game" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Grid.Column="1" Text="{Binding PathStatus}" FontSize="11"
                                       Opacity="0.68" VerticalAlignment="Center" />
                        </Grid>
                        <ui:TextBox Text="{Binding GamePath}" IsReadOnly="True"
                                    PlaceholderText="Chưa chọn thư mục game" FontSize="11"
                                    Margin="0,0,0,9" />
                        <WrapPanel>
                            <Button Content="Tự tìm" Command="{Binding AutoDetectCommand}"
                                    Padding="10,6" Margin="0,0,7,6" />
                            <Button Content="Chọn thư mục" Command="{Binding ChooseFolderCommand}"
                                    Padding="10,6" Margin="0,0,7,6" />
                            <Button Content="Mở thư mục" Command="{Binding OpenFolderCommand}"
                                    Padding="10,6" Margin="0,0,7,6" />
                            <Button Content="Kiểm tra" Command="{Binding CheckFilesCommand}"
                                    Padding="10,6" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:InfoBar IsOpen="True" Severity="Informational" Title="Trạng thái"
                        Message="{Binding Message}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
