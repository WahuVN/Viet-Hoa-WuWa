<UserControl x:Class="VHWuWa.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,24,26,28" MaxWidth="940" HorizontalAlignment="Stretch">
            <!-- Nội dung rõ ràng, không che cài đặt thật bằng các nhãn trang trí. -->
            <TextBlock Text="TÙY CHỌN  /  ỨNG DỤNG"
                       FontSize="11" FontWeight="SemiBold" Foreground="#B6C2CF"
                       Margin="0,0,0,9" />
            <TextBlock Text="Cài đặt" FontSize="29" FontWeight="Bold" />
            <TextBlock Text="Quản lý thư mục game, giao diện và cách kiểm tra bản cập nhật."
                       FontSize="12" Opacity="0.78" TextWrapping="Wrap"
                       Margin="0,8,0,20" />

            <ui:Card Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="01  /  VỊ TRÍ GAME" FontSize="11"
                               Foreground="#B6C2CF" FontWeight="SemiBold"
                               Margin="0,0,0,7" />
                    <TextBlock Text="Thư mục Wuthering Waves"
                               FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Chọn thư mục cài game chính xác để ứng dụng có thể kiểm tra phiên bản và dữ liệu."
                               FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                               Margin="0,6,0,13" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding GamePath}" IsReadOnly="True"
                                    PlaceholderText="Chưa tìm thấy thư mục game"
                                    FontSize="12" MinHeight="38"
                                    VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Content="Chọn thư mục"
                                   Command="{Binding ChooseFolderCommand}"
                                   Appearance="Secondary" Padding="15,8"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="02  /  GIAO DIỆN" FontSize="11"
                               Foreground="#B6C2CF" FontWeight="SemiBold"
                               Margin="0,0,0,7" />
                    <TextBlock Text="Hiển thị &amp; tùy chọn" FontSize="17"
                               FontWeight="SemiBold" Margin="0,0,0,13" />
                    <CheckBox Content="Sử dụng chế độ tối"
                              IsChecked="{Binding IsDark}"
                              FontSize="13" Margin="0,0,0,10" />
                    <TextBlock Text="Chế độ sáng/tối chỉ thay đổi giao diện ứng dụng, không sửa font hoặc hình ảnh trong game."
                               FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               Margin="26,0,0,13" />
                    <Separator Opacity="0.3" Margin="0,0,0,14" />
                    <CheckBox Content="Tự kiểm tra phiên bản ứng dụng khi khởi động"
                              IsChecked="{Binding AutoCheckUpdate}"
                              FontSize="13" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="03  /  CẬP NHẬT" FontSize="11"
                               Foreground="#B6C2CF" FontWeight="SemiBold"
                               Margin="0,0,0,7" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ứng dụng WuWa Việt Hóa"
                                       FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AppVersion}"
                                       FontSize="12" Opacity="0.75" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="12"
                                BorderThickness="1" BorderBrush="#3A434D"
                                Background="#171A1F" Padding="13,8"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="KIỂM TRA PHIÊN BẢN"
                                       FontSize="10" Foreground="#B6C2CF"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <WrapPanel Margin="0,0,0,9">
                        <ui:Button Content="Kiểm tra cập nhật"
                                   Appearance="Secondary" Command="{Binding CheckUpdateCommand}"
                                   Padding="15,9" Margin="0,0,8,6" />
                        <ui:Button Content="Cài bản mới"
                                   Appearance="Primary" ToolTip="Tải ZIP từ GitHub, kiểm tra SHA-256 rồi cập nhật và mở lại ứng dụng."
                                   Command="{Binding Main.ApplyUpdateCommand}"
                                   Visibility="{Binding Main.HasUpdate, Converter={StaticResource BoolToVis}}"
                                   Padding="15,9" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding UpdateMessage}" FontSize="12"
                               TextWrapping="Wrap" Opacity="0.85" />
                    <StackPanel Margin="0,13,0,0"
                                Visibility="{Binding Main.HasUpdate, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Main.UpdateTitle}"
                                   FontWeight="SemiBold" Foreground="#B6C2CF" />
                        <TextBlock Text="{Binding Main.UpdateNotes}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Opacity="0.8" Margin="0,4,0,0" />
                        <ProgressBar Value="{Binding Main.UpdateProgress}" Maximum="100"
                                     Height="7" Margin="0,12,0,0"
                                     Visibility="{Binding Main.IsUpdating, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Main.UpdateStatusMessage}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"
                                   Visibility="{Binding Main.IsUpdating, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Text="Bản dịch và ứng dụng sẽ có cơ chế cập nhật riêng khi gói nội dung phù hợp được xác minh."
                               FontSize="11" Opacity="0.68" TextWrapping="Wrap"
                               Margin="0,14,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- Portable is intentional: let users see where the actual EXE lives. -->
            <ui:Card Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="04  /  ỨNG DỤNG PORTABLE"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,7" />
                    <TextBlock Text="Không cần bộ cài Setup.exe"
                               FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Tải ZIP từ GitHub, giải nén vào một thư mục cố định rồi mở VHWuWa.exe. Ứng dụng sẽ tạo lối tắt WuWa trên Desktop."
                               FontSize="12.5" TextWrapping="Wrap" Margin="0,7,0,7"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Khi có bản mới, ứng dụng sẽ hỏi trước khi tải và cập nhật ngay trong thư mục đó. Cấu hình được lưu riêng, không cần giải nén lại."
                               FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <WrapPanel>
                        <Button Style="{StaticResource WahuStandardButtonStyle}"
                                Content="Mở thư mục ứng dụng" Command="{Binding OpenAppFolderCommand}"
                                ToolTip="Xem thư mục chứa VHWuWa.exe đang chạy"
                                Margin="0,0,8,6" Padding="14,8" />
                        <Button Style="{StaticResource WahuStandardButtonStyle}"
                                Content="Mở thư mục nhật ký" Command="{Binding OpenLogFolderCommand}"
                                Margin="0,0,0,6" Padding="14,8" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
