<UserControl x:Class="VHWuWa.App.Views.CharacterNamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tên nhân vật" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Chỉnh cách hiển thị tên từng nhân vật."
                           Margin="0,3,0,0" Opacity="0.72" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
            <Border Grid.Column="1" Background="#171A1F" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                <TextBlock Text="{Binding DirtyCount, StringFormat='Đã sửa: {0}'}" Foreground="#B6C2CF" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <ui:Card Grid.Row="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusSummary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}" VerticalAlignment="Center" FontSize="12" />
                <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Expander Header="Khôi phục" IsExpanded="False" Margin="0,0,10,0">
                        <StackPanel Margin="8,6">
                            <Button Content="Đặt lại tên" Command="{Binding ResetBuildCommand}" IsEnabled="{Binding CanEditBuild}"
                                    Padding="10,7" Margin="0,0,0,6"/>
                            <Button Content="Tải PAK gốc" Command="{Binding RestorePaksCommand}" IsEnabled="{Binding CanEditBuild}"
                                    Padding="10,7"/>
                        </StackPanel>
                    </Expander>
                    <ui:Button Content="Lưu &amp; tạo PAK" Appearance="Secondary"
                               Command="{Binding SaveBuildCommand}" IsEnabled="{Binding CanEditBuild}"
                               Padding="12,8" FontWeight="SemiBold"/>
                </WrapPanel>
            </Grid>
        </ui:Card>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="7" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Items}" IsReadOnly="False" SelectionUnit="FullRow"
                      RowHeight="58" HeadersVisibility="Column" EnableRowVirtualization="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Nhân vật" Width="78" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="44" Height="44" Margin="5">
                                    <Border CornerRadius="22" Background="#171A1F" BorderBrush="#292D33" BorderThickness="1">
                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="#969DA6" />
                                    </Border>
                                    <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Tên mặc định" Binding="{Binding DefaultName}" Width="150" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Tiếng Việt" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Vi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5" Margin="4" VerticalContentAlignment="Center"
                                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Hán Việt" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Hv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5" Margin="4" VerticalContentAlignment="Center"
                                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <!-- Khung trạng thái và tiến độ xử lý nổi bật -->
            <Border Background="#171A1F" BorderBrush="#B6C2CF" BorderThickness="1" CornerRadius="7" Padding="12,9"
                    Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Status}" Foreground="#B6C2CF"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="5" Foreground="#B6C2CF" />
                </Grid>
            </Border>

            <Border Background="#171A1F" BorderBrush="#3A434D" BorderThickness="1" CornerRadius="12" Padding="14,10"
                    Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}" Margin="0,7,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding InstallPromptMessage}"
                               Foreground="#B6C2CF" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                        <ui:Button Content="Cài Việt hóa"
                                   Appearance="{Binding ViAppearance}"
                                   Command="{Binding InstallViCommand}"
                                   ToolTip="Cài bản Việt hóa đã lưu"
                                   Margin="0,0,10,0" Padding="14,6" FontWeight="SemiBold" />
                        <ui:Button Content="Cài Hán Việt"
                                   Appearance="{Binding HvAppearance}"
                                   Command="{Binding InstallHvCommand}"
                                   ToolTip="Cài bản Hán Việt đã lưu"
                                   Padding="14,6" FontWeight="SemiBold" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
