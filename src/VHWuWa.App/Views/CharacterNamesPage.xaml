<UserControl x:Class="VHWuWa.App.Views.CharacterNamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource Wahu.PageBackground}">
    <Grid Margin="28,52,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tên nhân vật" Foreground="{DynamicResource Wahu.Text}" FontFamily="{StaticResource WahuHeadingFontFamily}" FontSize="28" FontWeight="SemiBold" />
                
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Wahu.TableSurface}" BorderBrush="{DynamicResource Wahu.Border}"
                    BorderThickness="1" CornerRadius="9" Padding="12,6" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DirtyCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding DirtyCount, StringFormat='Đã sửa {0}'}"
                           Foreground="{DynamicResource Wahu.Accent}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Wahu.Surface}" BorderBrush="#7E8786C9" BorderThickness="1" CornerRadius="11" Padding="12,7" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusSummary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}" VerticalAlignment="Center" FontSize="12" />
                <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Expander Header="Khôi phục" IsExpanded="False" Margin="0,0,10,0">
                        <StackPanel Margin="8,6">
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Đặt lại tên" Command="{Binding ResetBuildCommand}" IsEnabled="{Binding CanEditBuild}"
                                    Padding="10,7" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource WahuStandardButtonStyle}" Content="Tải PAK gốc" Command="{Binding RestorePaksCommand}" IsEnabled="{Binding CanEditBuild}"
                                    Padding="10,7"/>
                        </StackPanel>
                    </Expander>
                    <Button Style="{StaticResource Wahu.PrimaryButton}" Content="Lưu và tạo PAK"
                               Command="{Binding SaveBuildCommand}" IsEnabled="{Binding CanEditBuild}"
                               Padding="12,8" FontWeight="SemiBold"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Wahu.TableSurface}" BorderBrush="{DynamicResource Wahu.Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <DataGrid VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Items}" IsReadOnly="False" SelectionUnit="FullRow"
                      RowHeight="52" HeadersVisibility="Column" EnableRowVirtualization="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Nhân vật" Width="96" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="40" Height="40" Margin="3">
                                    <Border CornerRadius="20" Background="{DynamicResource Wahu.TableSurface}" BorderBrush="{DynamicResource Wahu.Border}" BorderThickness="1">
                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="{DynamicResource Wahu.Muted}" />
                                    </Border>
                                    <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Tên mặc định" Binding="{Binding DefaultName}" Width="174" IsReadOnly="True" ElementStyle="{StaticResource Wahu.TableCellText}" />
                    <DataGridTemplateColumn Header="Tiếng Việt" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource Wahu.EditorInput}" Text="{Binding Vi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,4" Margin="3" VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Hán Việt" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource Wahu.EditorInput}" Text="{Binding Hv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,4" Margin="3" VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <!-- Khung trạng thái và tiến độ xử lý nổi bật -->
            <Border Background="{DynamicResource Wahu.TableSurface}" BorderBrush="{DynamicResource Wahu.Muted}" BorderThickness="1" CornerRadius="7" Padding="12,9"
                    Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Status}" Foreground="{DynamicResource Wahu.Muted}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="5" Foreground="{DynamicResource Wahu.Muted}" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource Wahu.TableSurface}" BorderBrush="{DynamicResource Wahu.Border}" BorderThickness="1" CornerRadius="12" Padding="14,10"
                    Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}" Margin="0,7,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding InstallPromptMessage}"
                               Foreground="{DynamicResource Wahu.Muted}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                        <ui:Button Content="Cài Việt hóa"
                                   Appearance="{Binding ViAppearance}"
                                   Command="{Binding InstallViCommand}"
                                   ToolTip="Cài bản Việt hóa đã lưu"
                                   Margin="0,0,10,0" Padding="14,6" FontWeight="SemiBold" />
                        <ui:Button Content="Cài Hán Việt"
                                   Appearance="{Binding HvAppearance}"
                                   Command="{Binding InstallHvCommand}"
                                   ToolTip="Cài bản Hán Việt đã lưu"
                                   Padding="14,6" FontWeight="SemiBold" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
